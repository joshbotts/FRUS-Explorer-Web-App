#!/usr/bin/env bash
# FRUS Explorer Light: fetches search by meaning's model (PLAN's S27b) into a folder, as the image's model
# stage would, for a build to take as its model-source context:
#   scripts/fetch-model <folder>
#   docker build --build-context model-source=<folder> -f docker/Dockerfile …
# The file is the one docker/Dockerfile names, MODEL_URL, fetched through the one redirect GitHub answers a
# release's file with, and held to MODEL_BYTES and MODEL_SHA256, the app's published length and the bundled
# index's digest, which EncoderImageTests holds those lines to. A file already there that holds to both is
# kept, so that CI, which keeps the folder in the Actions cache by the digest, fetches it once a model. Prints
# the digest.
set -euo pipefail

[ $# -eq 1 ] || { echo "usage: scripts/fetch-model <folder>" >&2; exit 2; }
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
folder=$1
argument() { sed -n "s/^ARG $1=//p" "$root/docker/Dockerfile"; }
url=$(argument MODEL_URL)
bytes=$(argument MODEL_BYTES)
sha256=$(argument MODEL_SHA256)
[ -n "$url" ] && [ -n "$bytes" ] && [ -n "$sha256" ] || { echo "fetch-model: docker/Dockerfile names no model" >&2; exit 1; }
name=${url##*/}
file="$folder/$name"

digest() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi
}
size() { wc -c < "$1" | tr -d ' '; }

if [ -f "$file" ] && [ "$(size "$file")" = "$bytes" ] && [ "$(digest "$file")" = "$sha256" ]; then
  echo "fetch-model: $file is the model already, $bytes bytes, SHA-256 $sha256"
  exit 0
fi
mkdir -p "$folder"
partial="$file.partial"
rm -f "$partial"
curl --fail --silent --show-error --location --max-redirs 1 --proto '=https' --proto-redir '=https' --retry 3 \
  --output "$partial" "$url"
got=$(size "$partial")
if [ "$got" != "$bytes" ]; then
  rm -f "$partial"
  echo "fetch-model: $name is $got bytes, where the app publishes $bytes" >&2
  exit 1
fi
got=$(digest "$partial")
if [ "$got" != "$sha256" ]; then
  rm -f "$partial"
  echo "fetch-model: $name's SHA-256 is $got, where the bundled index names $sha256" >&2
  exit 1
fi
mv "$partial" "$file"
echo "fetch-model: fetched $file, $bytes bytes, SHA-256 $sha256"
