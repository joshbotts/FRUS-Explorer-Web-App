# One whose external entity names a file of the image's: its document is indexed without the file's text.
cat > "$work/smoke-entity.xml" <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE TEI [<!ENTITY passwd SYSTEM "file:///etc/passwd">]>
<TEI xmlns="http://www.tei-c.org/ns/1.0"><teiHeader><fileDesc><titleStmt><title type="complete">A volume naming a file of the image's</title></titleStmt></fileDesc></teiHeader>
<text><body><div type="document" xml:id="d1" n="1"><head>One</head><p>Smokeprobe before &passwd; after.</p></div></body></text></TEI>
XML
entity=$(library_sideload smoke-entity.xml "$work/smoke-entity.xml")
case "$entity" in *'"volumeId":"smoke-entity"'*' 202') ;; *) fail "the side-load naming a file was not taken: $entity" ;; esac
