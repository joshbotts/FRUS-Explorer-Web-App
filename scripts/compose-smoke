assert all(volumes[i]["blobSha"] and not volumes[i].get("error") for i in ["frus1894Nicaragua", "frus1961-63v06", "frus1969-76ve09p1"])' "$work/library.json" \
  || fail "the Library does not list the three as downloaded and indexed, with frus1969-76ve09p1's 7 figures and 1 refused"
