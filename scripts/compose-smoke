echo "== admin: the library's indexing, its index summarized as check 2 does, and a volume that does not parse (PLAN's S21d)"
# frus-parity from an image of the Dockerfile's parity stage, which CI's compose job builds beside the image
# (FRUS_PARITY_IMAGE): the index the job wrote, copied out once the job has folded its log into it, is
# summarized and held to fixtures/golden's summary. Without one, as for a published image, check 2 is said
# to be skipped.
if [ -n "${FRUS_PARITY_IMAGE:-}" ]; then
  library_compose cp frus:/data/index/frus.db "$work/standalone.db" || fail "the Standalone server's index could not be copied out"
  parity() { docker run --rm --user "$(id -u):$(id -g)" -v "$work:/work" -v "$PWD:/repo:ro" "$FRUS_PARITY_IMAGE" frus-parity "$@"; }
  parity summarize /work/standalone.db --golden /work/standalone-summary.json --repo /repo \
    --upstream-commit "$(git -C upstream/FRUS-Explorer rev-parse HEAD)" > "$work/standalone-summary.log" 2>&1 \
    || fail "frus-parity did not summarize the Standalone server's index: $(tail -5 "$work/standalone-summary.log")"
  parity compare-summary /repo/fixtures/golden/index-summary.json /work/standalone-summary.json > "$work/standalone-compare.log" 2>&1 \
    || fail "check 2 fails over the Standalone server's index: $(tail -8 "$work/standalone-compare.log")"
  grep -q '^check 2 passes' "$work/standalone-compare.log" || fail "check 2's comparison said nothing: $(cat "$work/standalone-compare.log")"
  echo "   over the index the server's indexing job wrote: $(grep '^check 2 passes' "$work/standalone-compare.log")"
else
  echo "   check 2 over the Standalone index: skipped, since FRUS_PARITY_IMAGE names no image of the parity stage"
fi

# The broken volume: downloaded and checked, then indexed in a job of its own, which fails it with its stage
