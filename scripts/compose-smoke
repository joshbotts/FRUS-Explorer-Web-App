#!/usr/bin/env bash
# FRUS Explorer Light: the Compose smoke test (session 5).
# Starts compose.yaml's server, checks the browser app, the catalogue and the reader before any
# import, imports a synthetic export with docker compose cp, and waits for /readyz to answer 200;
# then checks the image's labels against the server's status, searches the index, reads a
# document's page, makes and deletes a tag through the API's write guard (PLAN's S14c), and checks
# the user, the read-only root, the health check and a restart. Then it
# makes the container again with FRUS_PUBLIC_URL ending in /frus-explorer/ and checks the server
# under that path (PLAN's S14f), where it imports a Mac JSON export of more than 4 MiB through
# nginx (S16c), then an export made with the owner's writing, whose installed index
# scripts/check-stripped-export searches for it, and one whose strip outgrows a 64 KB /tmp, in a
# container of its own (S16e). Then it backs up the user store with frus-light backup, fetches the
# backup through GET /api/v1/admin/backup, removes the store, restores it with frus-light restore and
# reads the same research back (S14b). docs/INSTALL.md's nginx recipes, for the root and for a path,
# run in nginx on the Compose network in each phase. Then the server signs people in with accounts of
# its own (S20b), FRUS_AUTH=local, two made with frus-light user, whose sessions, refusals and slowing
# it checks. Last, the server signs people in through the
# proxy (S14e), with FRUS_AUTH=header and nginx's address alone in FRUS_TRUSTED_PROXIES: the install
# guide's recipe for it runs with a stand-in for its session check, a header from outside the list
# is refused, and two users' tags stay apart. Its TEI folder holds fixtures/tei's volumes and the
# kit's fixture for a section's own text,
# fixtures/own-text/frus1969-76v01.xml, whose rows the export holds too. Between the research steps and
# nginx at the root it starts the pdf profile, once, for the rest of the run: before it, the server
# offers no PDF; with it, a collection's PDF comes through Gotenberg's Chromium and holds the titles its
# HTML export gives its documents, which scripts/pdf-text reads, and the browser suite exports one by
# keyboard (PLAN's S25a). It needs python3, for scripts/pdf-text.
#   scripts/compose-smoke                       builds the image as frus-light:smoke first
#   FRUS_IMAGE=<image> scripts/compose-smoke    tests an image already built
#   FRUS_PARITY_IMAGE=<image>                   names an image of the Dockerfile's parity stage, whose
#                                               frus-parity summarizes the Standalone project's index for
#                                               check 2 (PLAN's S21d); the script builds one beside an
#                                               image it builds itself, and without either skips check 2
#   scripts/compose-smoke --e2e                 also runs web/e2e, Playwright on Chromium, against the
#                                               imported server at the root, then under the path
#                                               through nginx, its accounts spec with local
#                                               accounts, and its sign-in spec through the
#                                               proxy that signs people in (scripts/npm ci first)
# It uses its own Compose project and host port, and removes its containers and volume afterwards.
# Each step's line names its area, as web/src/router.tsx and copy.ts group theirs: the install (the
# image, Compose, the proxy's recipes and the health check), browse and search, the reader, research,
# settings and admin, and all areas for the browser suite. A row adds its step beside its area's kin,
# in the phase whose state the step needs, never at the end (PLAN, How sessions run beside each
# other, rule 4).
set -euo pipefail

e2e=""
case "${1:-}" in
  --e2e) e2e=1 ;;
  "") ;;
  *) echo "usage: scripts/compose-smoke [--e2e]" >&2; exit 2 ;;
esac

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
if ! command -v docker >/dev/null 2>&1 && [ -x "$HOME/.docker/bin/docker" ]; then
  PATH="$HOME/.docker/bin:$PATH"
fi

export COMPOSE_PROJECT_NAME="frus-smoke-$$"
export FRUS_HOST_PORT="${FRUS_HOST_PORT:-18080}"
# The address the browser suite opens, in the server's network namespace: a change must come from
# it and be sent to it (PLAN's S14c). curl reaches the same server on the host's port.
export FRUS_PUBLIC_URL=http://localhost:8080
if [ -z "${FRUS_IMAGE:-}" ]; then
  export FRUS_IMAGE=frus-light:smoke
  echo "== install: building $FRUS_IMAGE"
  build_args=()
  while IFS= read -r arg; do build_args+=(--build-arg "$arg"); done < <(scripts/release build-args)
  docker build -f docker/Dockerfile "${build_args[@]}" -t "$FRUS_IMAGE" .
  # frus-parity beside it, from the same build's cache, for check 2 over the Standalone index (S21d).
  if [ -z "${FRUS_PARITY_IMAGE:-}" ]; then
    export FRUS_PARITY_IMAGE=frus-light:smoke-parity
    docker build -f docker/Dockerfile "${build_args[@]}" --target parity -t "$FRUS_PARITY_IMAGE" .
  fi
fi
base="http://127.0.0.1:$FRUS_HOST_PORT"
proxy="$COMPOSE_PROJECT_NAME-proxy"
proxy_image=nginx:1.28-alpine
work=$(mktemp -d)
passed=""
mkdir "$work/tei"
cp fixtures/tei/*.xml fixtures/own-text/frus1969-76v01.xml "$work/tei/"
export FRUS_TEI_DIR="$work/tei"
# The host folder each backup is copied to (S14b), which the server's user, UID 10001, must be able
# to write: docs/INSTALL.md has a Linux host chown it, and Docker Desktop lets any user write one.
mkdir "$work/backups"
chmod 0777 "$work/backups"
export FRUS_BACKUP_DIR="$work/backups"
# The daily backup's hour is the container's time zone's, which the image's own data must know.
export TZ=America/New_York

cleanup() {
  if [ -z "$passed" ]; then
    echo "== the smoke test failed; the server's log:"
    docker compose logs --no-color frus 2>&1 | tail -50 || true
    # Gotenberg's, once a step has started it: a print it refuses names its cause there alone.
    # The library's Standalone project's, once its step has started it (PLAN's S21c), and its mirror's.
    if [ -n "$(docker compose -p "$COMPOSE_PROJECT_NAME-library" -f compose.yaml -f compose.standalone.yaml ps -aq frus 2>/dev/null)" ]; then
      echo "== the Standalone project's server log:"
      docker compose -p "$COMPOSE_PROJECT_NAME-library" -f compose.yaml -f compose.standalone.yaml logs --no-color frus 2>&1 | tail -40 || true
      echo "== its mirror's log:"
      docker logs "$COMPOSE_PROJECT_NAME-library-github" 2>&1 | tail -20 || true
    fi
    if [ -n "$(COMPOSE_PROFILES=pdf docker compose ps -aq pdf 2>/dev/null)" ]; then
      echo "== the pdf service's log:"
      COMPOSE_PROFILES=pdf docker compose logs --no-color pdf 2>&1 | tail -40 || true
    fi
  fi
  docker rm -f "$proxy" "$COMPOSE_PROJECT_NAME-tmp-volume" "$COMPOSE_PROJECT_NAME-tmp-tmp" "$COMPOSE_PROJECT_NAME-keyless" \
    "$COMPOSE_PROJECT_NAME-library-github" >/dev/null 2>&1 || true
  # The library's Standalone project (PLAN's S21c), with its volume.
  docker compose -p "$COMPOSE_PROJECT_NAME-library" -f compose.yaml -f compose.standalone.yaml down --volumes --remove-orphans >/dev/null 2>&1 || true
  docker volume rm "$COMPOSE_PROJECT_NAME-tmp-volume" "$COMPOSE_PROJECT_NAME-tmp-tmp" >/dev/null 2>&1 || true
  # With the pdf profile, whether or not a step started it, so that its container and network go too.
  COMPOSE_PROFILES=pdf docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }

# Waits up to $2 seconds for $1 to answer 200, printing each new readiness step it sees.
wait_for_200() {
  local url=$1 seconds=$2 last="" code body step
  for _ in $(seq 1 $((seconds * 4))); do
    body=$(curl -s --max-time 5 -w '\n%{http_code}' "$url" 2>/dev/null || true)
    code=${body##*$'\n'}
    step=$(printf '%s' "${body%$'\n'*}" | sed -nE 's/.*"step":"([a-z_]+)".*/\1/p')
    if [ -n "$step" ] && [ "$step" != "$last" ]; then echo "   $code $step"; last=$step; fi
    [ "$code" = 200 ] && return 0
    sleep 0.25
  done
  return 1
}

# Starts nginx on the Compose network with docs/INSTALL.md's recipe $1, "at the root", "under a
# path" or "signing in": its location blocks in a server on port 8080, IPv4 and IPv6, since
# localhost is ::1 first in its container, whose upstream is the frus service, and after it the
# configuration in the file $3, if given. Waits for $2, a path the recipe forwards, to answer 200
# through it.
start_proxy() {
  awk -v marker="<!-- compose-smoke: nginx $1 -->" '$0 == marker {found = 1; next}
    found && /^```nginx$/ {copy = 1; next} copy && /^```$/ {exit} copy' docs/INSTALL.md > "$work/locations.conf"
  [ -s "$work/locations.conf" ] || fail "docs/INSTALL.md has no nginx recipe $1"
  { echo 'server {'; echo '    listen 8080;'; echo '    listen [::]:8080;'; sed 's|http://127\.0\.0\.1:8080|http://frus:8080|' "$work/locations.conf"; echo '}'
    if [ -n "${3:-}" ]; then cat "$3"; fi; } > "$work/nginx.conf"
  docker rm -f "$proxy" >/dev/null 2>&1 || true
  docker run -d --name "$proxy" --network "${COMPOSE_PROJECT_NAME}_default" --pull missing -q \
    -v "$work/nginx.conf:/etc/nginx/conf.d/default.conf:ro" "$proxy_image" >/dev/null || fail "nginx did not start"
  for _ in $(seq 1 40); do
    [ "$(through_proxy "$2")" = 200 ] && return 0
    sleep 0.25
  done
  fail "nginx did not answer $2: $(docker logs "$proxy" 2>&1 | tail -5)"
}

# The status GET $1 ends with through the proxy, redirects followed, from inside its container.
through_proxy() {
  docker exec "$proxy" wget -q -S -O /dev/null "http://localhost:8080$1" 2>&1 \
    | sed -nE 's/^ *HTTP\/1\.[01] ([0-9]+).*/\1/p' | tail -1
}

echo "== admin: a synthetic export"
scripts/synthetic-export --own-text "$work/export.sqlite"

echo "== install: docker compose up (image $FRUS_IMAGE)"
docker compose up -d frus   # the optional pdf service needs no test
wait_for_200 "$base/healthz" 30 || fail "/healthz did not answer 200"

echo "== install: user, filesystem and network"
container=$(docker compose ps -q frus)
uid=$(docker compose exec -T frus id -u)
[ "$uid" = 10001 ] || fail "the server runs as UID $uid, not 10001"
# As root, so the checks test the mounts rather than the server user's permissions.
[ "$(docker inspect --format '{{.HostConfig.ReadonlyRootfs}}' "$container")" = true ] || fail "the root filesystem is not read-only"
if docker compose exec -T -u 0 frus touch /probe 2>/dev/null; then fail "root can write to the root filesystem"; fi
docker compose exec -T frus sh -c 'touch /data/probe && rm /data/probe && touch /tmp/probe' || fail "/data or /tmp is not writable"
docker compose exec -T frus sh -c 'touch /backups/probe && rm /backups/probe' || fail "the backups folder is not writable"
docker compose exec -T frus test -r /data/volumes/frus1894Nicaragua.xml || fail "the TEI folder is not mounted"
if docker compose exec -T -u 0 frus touch /data/volumes/probe 2>/dev/null; then fail "the TEI folder is writable"; fi
published=$(docker compose port frus 8080)
[ "${published%:*}" = 127.0.0.1 ] || fail "the port is published on $published, not 127.0.0.1"
echo "   UID 10001; root read-only; /data, /backups and /tmp writable; TEI read-only; port on 127.0.0.1"

echo "== admin: the daily backup's first look"
# At its start the server looks at its backups, and finds a new store that holds no research yet,
# which it does not back up: its first backup comes at the look after the first write (S14b).
looked=""
for _ in $(seq 1 60); do
  looked=$(docker compose logs --no-color frus 2>&1 | grep -c "app.db holds no research yet, so no backup was taken" || true)
  [ "$looked" -gt 0 ] && break
  sleep 0.25
done
[ "$looked" -gt 0 ] || fail "the server did not look at its backups: $(docker compose logs --no-color frus 2>&1 | grep -i backup | tail -3)"
[ -z "$(ls -A "$work/backups")" ] || fail "a new store was backed up: $(ls "$work/backups")"
# The whole log first: grep -q would stop reading it at its match, and under pipefail the writer's
# broken pipe would fail the check.
server_log=$(docker compose logs --no-color frus 2>&1)
case "$server_log" in *"backed up daily at 03:00 America/New_York"*) ;;
  *) fail "the server does not name the backup's hour in TZ's time zone: $(printf '%s\n' "$server_log" | grep -i 'backed up daily' | tail -1)" ;;
esac
echo "   none of a new store; daily at 03:00 America/New_York"

echo "== install: the browser app"
# The app's page and every client route answer with the same index.html and the app's policy; a
# missing file and an unknown API path do not.
app=$(curl -s --max-time 5 -D "$work/app.headers" -o "$work/app.html" -w '%{http_code} %{content_type}' "$base/" || true)
[ "$app" = "200 text/html; charset=utf-8" ] || fail "/ answered $app"
grep -qi "^content-security-policy: default-src 'self'" "$work/app.headers" || fail "/ has no content security policy"
grep -qi '^cache-control: no-cache' "$work/app.headers" || fail "/ may be cached"
grep -q '<base href="/" />' "$work/app.html" || fail "/ has no <base href=\"/\">"
grep -Eq '<script type="module"[^>]* src="\./assets/[^"]+\.js"' "$work/app.html" || fail "/ does not load the app's script"
if grep -Eq '<script( type="module")?>' "$work/app.html"; then fail "/ has an inline script the policy would block"; fi
for path in "/search?keywords=treaties" "/doc/frus1961-63v06/d1"; do
  curl -s --max-time 5 -o "$work/route.html" "$base$path" || fail "$path did not answer"
  cmp -s "$work/app.html" "$work/route.html" || fail "$path is not the app's page"
done
script=$(sed -nE 's/.*<script type="module"[^>]* src="([^"]+)".*/\1/p' "$work/app.html" | head -1)
curl -s --max-time 5 -D "$work/script.headers" -o /dev/null "$base/${script#./}" || fail "$script did not answer"
grep -qi '^cache-control: public, max-age=31536000, immutable' "$work/script.headers" || fail "$script is not cached as immutable"
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base/assets/no-such-file.js" || true)
[ "$code" = 404 ] || fail "a missing asset answered $code"
unknown=$(curl -s --max-time 5 -o /dev/null -w '%{http_code} %{content_type}' "$base/api/v1/no-such-endpoint" || true)
[ "$unknown" = "404 application/problem+json" ] || fail "an unknown API path answered $unknown"
echo "   / and two client routes give index.html with the app's policy; $script immutable; 404s for a missing asset and an unknown API path"

echo "== browse and search, the reader: before an import"
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base/readyz" || true)
[ "$code" = 503 ] || fail "/readyz answered $code before any import"
echo "   503 waiting_for_export"
# The catalogue comes from the image's copy of the app's data files, and the reader from the
# mounted TEI; neither needs an index.
volumes=$(curl -s --max-time 5 "$base/api/v1/volumes?limit=1") || fail "/api/v1/volumes did not answer"
printf '%s' "$volumes" | grep -q '"total":553' || fail "the catalogue does not list 553 volumes: $volumes"
reader=$(curl -s --max-time 30 -o "$work/d1.html" -w '%{http_code} %{content_type}' \
  "$base/api/v1/volumes/frus1894Nicaragua/documents/d1/html?part=body" || true)
[ "$reader" = "200 text/html; charset=utf-8" ] || fail "the reader answered $reader: $(head -c 300 "$work/d1.html")"
missing=$(curl -s --max-time 5 -w ' %{http_code}' "$base/api/v1/volumes/frus1961-63v99" || true)
case "$missing" in *'"code":"VOLUME_NOT_FOUND"'*' 404') ;; *) fail "an unknown volume answered $missing" ;; esac
echo "   catalogue of 553 volumes; frus1894Nicaragua d1 rendered, $(wc -c < "$work/d1.html" | tr -d ' ') bytes; problem details for an unknown volume"

echo "== admin: docker compose cp the export, then /readyz"
docker compose cp "$work/export.sqlite" frus:/data/import/export.sqlite
wait_for_200 "$base/readyz" 120 || fail "/readyz did not reach 200"
status=$(curl -s --max-time 5 "$base/api/v1/status") || fail "/api/v1/status did not answer"
printf '%s' "$status" | grep -q '"documents":7' || fail "status does not report 7 documents: $status"
echo "   status: $(printf '%s' "$status" | sed -nE 's/.*"sqliteVersion":"([^"]+)".*/SQLite \1/p'), 7 documents"

echo "== admin: the import's job (PLAN's S20d)"
# The export the drop zone took ran as a job of the server's queue, which the admin's list names,
# finished, asked for by the server itself; the admin step on local accounts finds it again, after the
# restarts between, since the queue keeps its jobs in the user store.
# /readyz turns 200 as the job installs the index, a moment before the job itself has finished.
import_job=""
for _ in $(seq 1 20); do
  jobs=$(curl -s --max-time 5 -H "Host: localhost:8080" "$base/api/v1/admin/jobs") || fail "/api/v1/admin/jobs did not answer"
  import_job=$(python3 -c 'import json, sys
jobs = [j for j in json.loads(sys.argv[1])["jobs"] if j["kind"] == "indexImport" and j.get("subject") == "export.sqlite"]
print(jobs[0]["id"] if len(jobs) == 1 and jobs[0]["state"] == "succeeded" and "requestedBy" not in jobs[0] else "")' "$jobs") \
    || fail "the jobs list is not one: $jobs"
  [ -n "$import_job" ] && break
  sleep 0.25
done
[ -n "$import_job" ] || fail "the jobs list does not name the import's job, finished: $jobs"
echo "   job $import_job, the index import of export.sqlite, finished"

echo "== admin: the library, a Standalone project downloading from a folder served as GitHub serves it (PLAN's S21c)"
# A Compose project of its own, compose.yaml with compose.standalone.yaml, whose server keeps its own
# volumes in /data/volumes and downloads them from an nginx serving a mirror: GitHub's listing of the three
# fixture volumes with their blob SHA-1s, the volumes' files, and frus1969-76ve09p1's figure images but its
# last, which the host does not have; the volumes' files served slowly enough that a restart lands while
# one downloads. Its volume is first an Import server's, with the TEI folder mounted; then, as a volume an
# older image left, its /data/volumes is root's, which a Standalone start refuses with the install guide's
# remedy, run here. Under FRUS_OFFLINE the server refuses and asks nothing; then it downloads the three, is
# restarted while it does, and finishes at its next start without asking again for what it had; every byte
# is the fixture's; the reader and its figures read them; and an export copied into /data/import seeds its
# index. From S21d the server indexes what it downloads, in a job of its own, which Status follows; check 2
# summarizes that index with frus-parity, built in the image's parity stage; and a catalogue volume the
# mirror serves broken is downloaded, reported failed with its stage, and removed.
library_project="$COMPOSE_PROJECT_NAME-library"
library_port=$((FRUS_HOST_PORT + 1))
library_base="http://127.0.0.1:$library_port"
library_github="$library_project-github"
mirror="$work/mirror"
raw="$mirror/raw.githubusercontent.com/HistoryAtState/frus/master/volumes"
figures="$mirror/static.history.state.gov/frus/frus1969-76ve09p1"
mkdir -p "$mirror/api.github.com/repos/HistoryAtState/frus/contents" "$raw" "$figures" "$work/library-backups"
chmod 0777 "$work/library-backups"
for id in frus1894Nicaragua frus1961-63v06 frus1969-76ve09p1; do cp "fixtures/tei/$id.xml" "$raw/"; done
# A catalogue volume served broken (S21d): its XML stops inside a paragraph, padded past the 20,000 bytes
# the kit's listing takes a volume from, so that it downloads and checks, and its indexing fails.
broken=frus1964-68v01
python3 - "$raw/$broken.xml" <<'PY' || fail "the broken volume could not be written"
import sys
xml = ('<?xml version="1.0" encoding="UTF-8"?>\n<TEI xmlns="http://www.tei-c.org/ns/1.0"><text><body>'
       '<div type="document" xml:id="d1"><head>One</head><p>A paragraph that is never closed\n')
xml += "<!-- " + "Padded past the 20,000 bytes the kit's listing takes a volume from. " * 400 + "-->\n"
open(sys.argv[1], "w", encoding="utf-8").write(xml)
PY
python3 - "$mirror" "$raw" "$figures" <<'PY' || fail "the mirror could not be written"
import json, os, struct, subprocess, sys, zlib
mirror, raw, figures = sys.argv[1:4]
listing = []
for name in sorted(os.listdir(raw)):
    path = os.path.join(raw, name)
    sha = subprocess.check_output(["git", "hash-object", "--no-filters", path], text=True).strip()
    listing.append({"name": name, "path": f"volumes/{name}", "sha": sha, "size": os.path.getsize(path), "type": "file",
                    "download_url": f"https://raw.githubusercontent.com/HistoryAtState/frus/master/volumes/{name}"})
listing.append({"name": "README.md", "path": "volumes/README.md", "sha": "0" * 40, "size": 120, "type": "file",
                "download_url": "https://raw.githubusercontent.com/HistoryAtState/frus/master/volumes/README.md"})
with open(os.path.join(mirror, "api.github.com/repos/HistoryAtState/frus/contents/volumes"), "w") as out:
    json.dump(listing, out)
def chunk(kind, data):
    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
for name in ["genassemblybldg", "OpenPitMine.jpg", "autoconveyorbelt.jpg", "SaharanFamily.jpg", "SpanishSaharaMap.jpg",
             "SpanishSaharaMap2.jpg", "1973SummitMeeting.jpg"]:
    png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 0, 0, 0, 0))
           + chunk(b"tEXt", b"Comment\x00" + name.encode()) + chunk(b"IDAT", zlib.compress(b"\x00\x80")) + chunk(b"IEND", b""))
    with open(os.path.join(figures, name + ".png"), "wb") as out:
        out.write(png)
PY
chmod -R a+rX "$mirror"
cat > "$work/mirror.conf" <<'NGINX'
server {
    listen 8000;
    root /srv/mirror;
    default_type application/octet-stream;
    access_log /dev/stdout;
    location /raw.githubusercontent.com/ { limit_rate 300k; }
}
NGINX
library_compose() {
  FRUS_AUTH=none FRUS_AUTH_HEADER='' FRUS_TRUSTED_PROXIES='' FRUS_ADMIN_USERS='' FRUS_USER_DATA=on FRUS_PUBLIC_URL=http://localhost:8080 \
    FRUS_HOST_PORT="$library_port" FRUS_BACKUP_DIR="$work/library-backups" FRUS_LIBRARY_MIRROR=http://github:8000/ COMPOSE_PROFILES='' \
    docker compose -p "$library_project" -f compose.yaml -f compose.standalone.yaml "$@"
}
library_api() {  # $1: method, $2: path, $3: body; prints the body and the status
  local token
  token=$(curl -s --max-time 5 -H "Host: localhost:8080" "$library_base/api/v1/me" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p')
  curl -s --max-time 10 -X "$1" -H "Host: localhost:8080" -H "Origin: http://localhost:8080" -H "X-CSRF-Token: $token" \
    -H 'Content-Type: application/json' ${3:+--data "$3"} -w ' %{http_code}' "$library_base$2"
}
# The Library's answer, about 170 KB for the catalogue's 553 volumes, goes to python3 in a file: Linux takes
# no single argument longer than 128 KiB (MAX_ARG_STRLEN).
library_list() { curl -s --max-time 10 -H "Host: localhost:8080" -o "$work/library.json" "$library_base/api/v1/admin/library"; }
library_counts() {  # the Library read again, and how many volumes it counts in each state, as status=count pairs
  library_list && python3 -c 'import json, sys
library = json.load(open(sys.argv[1], encoding="utf-8"))
print(" ".join(f"{k}={v}" for k, v in sorted(library["counts"].items())))' "$work/library.json"
}
library_sideload() {  # $1: the file's name, $2: the file; prints the body and the status (S21e)
  local token
  token=$(curl -s --max-time 5 -H "Host: localhost:8080" "$library_base/api/v1/me" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p')
  curl -s --max-time 30 -X POST -H "Host: localhost:8080" -H "Origin: http://localhost:8080" -H "X-CSRF-Token: $token" \
    -H 'Content-Type: application/xml' --data-binary "@$2" -w ' %{http_code}' "$library_base/api/v1/admin/library/sideload?file=$1"
}
library_jobs() { curl -s --max-time 10 -H "Host: localhost:8080" -o "$work/library-jobs.json" "$library_base/api/v1/admin/jobs"; }
library_idle() {  # waits until no job of the library's waits or runs (S21d, S21e), for at most $1 seconds
  local deadline=$((SECONDS + $1))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if library_jobs && python3 -c 'import json, sys
jobs = json.load(open(sys.argv[1], encoding="utf-8"))["jobs"]
kinds = ("libraryDownload", "libraryIndex", "libraryRemove", "indexCompact", "indexCheck", "indexReset")
sys.exit(0 if not any(j["kind"] in kinds and j["state"] in ("queued", "running") for j in jobs) else 1)' "$work/library-jobs.json"; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}
# Import mode first, compose.yaml alone, the TEI folder mounted on the folder the image made the server's.
FRUS_AUTH=none FRUS_AUTH_HEADER='' FRUS_TRUSTED_PROXIES='' FRUS_ADMIN_USERS='' FRUS_USER_DATA=on FRUS_PUBLIC_URL=http://localhost:8080 \
  FRUS_HOST_PORT="$library_port" FRUS_BACKUP_DIR="$work/library-backups" COMPOSE_PROFILES='' \
  docker compose -p "$library_project" -f compose.yaml up -d frus
wait_for_200 "$library_base/healthz" 30 || fail "the library project's Import server did not answer"
library_compose stop frus >/dev/null
# As a volume an Import server of an older image used: Docker made /data/volumes there, root's.
library_compose run --rm --no-deps --user 0 --cap-add CHOWN --entrypoint chown frus 0:0 /data/volumes \
  || fail "the volumes folder could not be given to root"
FRUS_OFFLINE=true library_compose up -d frus
refusal=""
for _ in $(seq 1 80); do
  refusal=$(library_compose logs --no-color frus 2>&1 | grep -c 'In Standalone mode the server keeps the volumes it downloads in /data/volumes, which it cannot write' || true)
  [ "$refusal" -gt 0 ] && break
  sleep 0.25
done
[ "$refusal" -gt 0 ] || fail "a Standalone server whose /data/volumes is root's did not refuse to start with its sentence: $(library_compose logs --no-color frus 2>&1 | tail -5)"
library_compose logs --no-color frus 2>&1 | grep -q -- '--cap-add CHOWN --entrypoint chown frus 10001:10001 /data/volumes' \
  || fail "the refusal does not give the remedy"
# The install guide's remedy, then the start again.
library_compose stop frus >/dev/null
library_compose run --rm --no-deps --user 0 --cap-add CHOWN --entrypoint chown frus 10001:10001 /data/volumes \
  || fail "the install guide's remedy did not run"
FRUS_OFFLINE=true library_compose up -d frus
docker run -d --name "$library_github" --network "${library_project}_default" --network-alias github --pull missing -q \
  -v "$mirror:/srv/mirror:ro" -v "$work/mirror.conf:/etc/nginx/conf.d/default.conf:ro" "$proxy_image" >/dev/null \
  || fail "the mirror's nginx did not start"
wait_for_200 "$library_base/healthz" 30 || fail "the Standalone server's /healthz did not answer 200 after the remedy"
library_compose exec -T frus sh -c 'test -d /data/volumes && touch /data/volumes/.probe && rm /data/volumes/.probe' \
  || fail "a Standalone server cannot write /data/volumes"
library_list || fail "the offline Library did not answer"
python3 -c 'import json, sys
library = json.load(open(sys.argv[1], encoding="utf-8"))
assert library["mode"] == "standalone" and library["offline"] and not library["downloads"] and "FRUS_OFFLINE" in library["unavailable"]' "$work/library.json" \
  || fail "the offline Library is not one: $(head -c 300 "$work/library.json")"

refused=$(library_api POST /api/v1/admin/library/downloads '{"all":true}')
case "$refused" in *'"code":"OFFLINE"'*' 409') ;; *) fail "a download under FRUS_OFFLINE answered $refused" ;; esac
[ -z "$(docker logs "$library_github" 2>&1 | grep 'GET /')" ] || fail "a server under FRUS_OFFLINE asked the mirror: $(docker logs "$library_github" 2>&1 | tail -3)"
echo "   under FRUS_OFFLINE: the Library says so, a download is refused, and the mirror was asked nothing"

FRUS_OFFLINE=false library_compose up -d frus
wait_for_200 "$library_base/healthz" 30 || fail "the Standalone server's /healthz did not answer 200 online"
posted=$(library_api POST /api/v1/admin/library/downloads '{"volumeIds":["frus1894Nicaragua","frus1961-63v06","frus1969-76ve09p1"]}')
case "$posted" in *'"kind":"libraryDownload"'*' 202') ;; *) fail "the download was not queued: $posted" ;; esac
first_job=$(printf '%s' "$posted" | sed -nE 's/.*"id":"([^"]+)".*/\1/p')
# The restart, once the first volume is downloaded and another is downloading.
restarted=""
for _ in $(seq 1 120); do
  counts=$(library_counts 2>/dev/null || true)
  case "$counts" in *downloaded=1*downloading=1*|*downloading=1*downloaded=1*) library_compose restart frus >/dev/null; restarted=1; break ;; esac
  case "$counts" in *downloaded=3*) break ;; esac
  sleep 0.25
done
[ -n "$restarted" ] || fail "no moment with one volume downloaded and one downloading came to restart in: $counts"
wait_for_200 "$library_base/healthz" 30 || fail "the Standalone server's /healthz did not answer 200 after its restart"
# Status read every twentieth of a second while the download goes on and the indexing follows it (S21d), and
# between two of its readings a search, whose answer the indexing job's run holds on both sides of it (S21e).
: > "$work/library-status.log"
: > "$work/library-search.log"
( while :; do
    before=$(curl -s --max-time 2 -H "Host: localhost:8080" "$library_base/api/v1/admin/status" 2>/dev/null | tr -d '\n')
    code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$library_base/api/v1/search?keywords=nicaragua" 2>/dev/null)
    after=$(curl -s --max-time 2 -H "Host: localhost:8080" "$library_base/api/v1/admin/status" 2>/dev/null | tr -d '\n')
    printf '%s\n%s\n' "$before" "$after" >> "$work/library-status.log"
    printf '%s\t%s\t%s\n' "$code" "$before" "$after" >> "$work/library-search.log"
    sleep 0.05
  done ) &
status_poller=$!
library_idle 120 || { kill "$status_poller" 2>/dev/null; fail "the download and its indexing did not end after the restart: $(head -c 400 "$work/library-jobs.json")"; }
kill "$status_poller" 2>/dev/null; wait "$status_poller" 2>/dev/null || true
counts=$(library_counts 2>/dev/null || true)
[ "$counts" = "indexed=3 notDownloaded=550" ] || fail "the three volumes downloaded are not indexed after the restart: $counts"
fetched=$(docker logs "$library_github" 2>&1 | grep -c 'GET /raw.githubusercontent.com/HistoryAtState/frus/master/volumes/frus1894Nicaragua.xml' || true)
[ "$fetched" = 1 ] || fail "frus1894Nicaragua, downloaded before the restart, was asked for $fetched times"
jobs=$(curl -s --max-time 5 -H "Host: localhost:8080" "$library_base/api/v1/admin/jobs")
python3 -c 'import json, sys
jobs = {j["id"]: j for j in json.loads(sys.argv[1])["jobs"]}
first = jobs[sys.argv[2]]
assert first["state"] == "failed" and first["error"] == "The server stopped while this job ran, so it did not finish.", first
resumed = [j for j in jobs.values() if j["kind"] == "libraryDownload" and j.get("subject", "").endswith("resumed after a restart")]
assert len(resumed) == 1 and resumed[0]["state"] == "succeeded" and "requestedBy" not in resumed[0], resumed
indexing = [j for j in jobs.values() if j["kind"] == "libraryIndex"]
assert len(indexing) == 1 and indexing[0]["state"] == "succeeded" and indexing[0]["progress"] == "Indexed 3 volumes." \
    and "requestedBy" not in indexing[0], indexing' "$jobs" "$first_job" \
  || fail "the jobs do not show the download stopped by the restart, resumed by the server, and one job indexing the three: $jobs"
python3 - "$work/library-status.log" <<'PY' || fail "Status never gave the indexing job's progress: $(grep -c libraryIndex "$work/library-status.log") readings named it"
import json, sys
seen = []
for line in open(sys.argv[1], encoding="utf-8"):
    try:
        running = json.loads(line)["jobs"].get("running")
    except (ValueError, KeyError, AttributeError):
        continue
    if running and running["kind"] == "libraryIndex" and running.get("progress", "").startswith("Indexing frus"):
        seen.append(running["progress"])
assert seen, "no reading named the indexing job running"
print(f"   Status gave the indexing job's progress {len(seen)} times, among them: {seen[0]}")
PY
# A search answered while the indexing job wrote the index (S21e, S21d's follow-up): 200 between two readings
# of Status that each name the job running, its first volume stored.
python3 - "$work/library-search.log" <<'PY' || fail "no search answered 200 while the indexing job ran: $(cut -f1 "$work/library-search.log" | sort | uniq -c | tr '\n' ' ')"
import json, sys
def running(text):
    try:
        job = json.loads(text)["jobs"].get("running")
    except (ValueError, KeyError, AttributeError):
        return None
    return job["id"] if job and job["kind"] == "libraryIndex" else None
held = []
for line in open(sys.argv[1], encoding="utf-8"):
    parts = line.rstrip("\n").split("\t")
    if len(parts) == 3 and parts[0] == "200" and running(parts[1]) and running(parts[1]) == running(parts[2]):
        held.append(parts[0])
assert held, "no 200 inside the job's run"
print(f"   search answered 200 {len(held)} times while the indexing job wrote the index, each between two readings of Status naming it running")
PY
(cd fixtures/tei && shasum -a 256 frus1894Nicaragua.xml frus1961-63v06.xml frus1969-76ve09p1.xml) | awk '{print $1, $NF}' | LC_ALL=C sort -k2 > "$work/expected.sha256"
library_compose exec -T frus sh -c 'cd /data/volumes && sha256sum frus1894Nicaragua.xml frus1961-63v06.xml frus1969-76ve09p1.xml' \
  | awk '{print $1, $NF}' | LC_ALL=C sort -k2 > "$work/downloaded.sha256"
diff "$work/expected.sha256" "$work/downloaded.sha256" >/dev/null || fail "a downloaded volume differs from its fixture: $(cat "$work/downloaded.sha256")"
(cd "$figures" && shasum -a 256 ./*.png) | awk '{print $1, $NF}' | LC_ALL=C sort -k2 > "$work/expected-figures.sha256"
