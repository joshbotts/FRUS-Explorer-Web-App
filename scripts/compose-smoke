#!/usr/bin/env bash
# FRUS Explorer Light: the Compose smoke test (session 5).
# Starts compose.yaml's server, checks the browser app, the catalogue and the reader before any
# import, imports a synthetic export with docker compose cp, and waits for /readyz to answer 200;
# then checks the image's labels against the server's status, searches the index, reads a
# document's page, makes and deletes a tag through the API's write guard (PLAN's S14c), and checks
# the user, the read-only root, the health check and a restart. Then it
# makes the container again with FRUS_PUBLIC_URL ending in /frus-explorer/ and checks the server
# under that path (PLAN's S14f). docs/INSTALL.md's nginx recipes, for the root and for a path, run
# in nginx on the Compose network in each phase. Its TEI folder holds fixtures/tei's volumes and the
# kit's fixture for a section's own text,
# fixtures/own-text/frus1969-76v01.xml, whose rows the export holds too.
#   scripts/compose-smoke                       builds the image as frus-light:smoke first
#   FRUS_IMAGE=<image> scripts/compose-smoke    tests an image already built
#   scripts/compose-smoke --e2e                 also runs web/e2e, Playwright on Chromium, against the
#                                               imported server at the root, then under the path
#                                               through nginx (scripts/npm ci first)
# It uses its own Compose project and host port, and removes its containers and volume afterwards.
set -euo pipefail

e2e=""
case "${1:-}" in
  --e2e) e2e=1 ;;
  "") ;;
  *) echo "usage: scripts/compose-smoke [--e2e]" >&2; exit 2 ;;
esac

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
if ! command -v docker >/dev/null 2>&1 && [ -x "$HOME/.docker/bin/docker" ]; then
  PATH="$HOME/.docker/bin:$PATH"
fi

export COMPOSE_PROJECT_NAME="frus-smoke-$$"
export FRUS_HOST_PORT="${FRUS_HOST_PORT:-18080}"
# The address the browser suite opens, in the server's network namespace: a change must come from
# it and be sent to it (PLAN's S14c). curl reaches the same server on the host's port.
export FRUS_PUBLIC_URL=http://localhost:8080
if [ -z "${FRUS_IMAGE:-}" ]; then
  export FRUS_IMAGE=frus-light:smoke
  echo "== building $FRUS_IMAGE"
  build_args=()
  while IFS= read -r arg; do build_args+=(--build-arg "$arg"); done < <(scripts/release build-args)
  docker build -f docker/Dockerfile "${build_args[@]}" -t "$FRUS_IMAGE" .
fi
base="http://127.0.0.1:$FRUS_HOST_PORT"
proxy="$COMPOSE_PROJECT_NAME-proxy"
proxy_image=nginx:1.28-alpine
work=$(mktemp -d)
passed=""
mkdir "$work/tei"
cp fixtures/tei/*.xml fixtures/own-text/frus1969-76v01.xml "$work/tei/"
export FRUS_TEI_DIR="$work/tei"

cleanup() {
  if [ -z "$passed" ]; then
    echo "== the smoke test failed; the server's log:"
    docker compose logs --no-color frus 2>&1 | tail -50 || true
  fi
  docker rm -f "$proxy" >/dev/null 2>&1 || true
  docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }

# Waits up to $2 seconds for $1 to answer 200, printing each new readiness step it sees.
wait_for_200() {
  local url=$1 seconds=$2 last="" code body step
  for _ in $(seq 1 $((seconds * 4))); do
    body=$(curl -s --max-time 5 -w '\n%{http_code}' "$url" 2>/dev/null || true)
    code=${body##*$'\n'}
    step=$(printf '%s' "${body%$'\n'*}" | sed -nE 's/.*"step":"([a-z_]+)".*/\1/p')
    if [ -n "$step" ] && [ "$step" != "$last" ]; then echo "   $code $step"; last=$step; fi
    [ "$code" = 200 ] && return 0
    sleep 0.25
  done
  return 1
}

# Starts nginx on the Compose network with docs/INSTALL.md's recipe $1, "at the root" or "under a
# path": its location blocks in a server on port 8080, IPv4 and IPv6, since localhost is ::1 first
# in its container, whose upstream is the frus service. Waits for $2, a health path the recipe
# forwards, to answer 200 through it.
start_proxy() {
  awk -v marker="<!-- compose-smoke: nginx $1 -->" '$0 == marker {found = 1; next}
    found && /^```nginx$/ {copy = 1; next} copy && /^```$/ {exit} copy' docs/INSTALL.md > "$work/locations.conf"
  [ -s "$work/locations.conf" ] || fail "docs/INSTALL.md has no nginx recipe $1"
  { echo 'server {'; echo '    listen 8080;'; echo '    listen [::]:8080;'; sed 's|http://127\.0\.0\.1:8080|http://frus:8080|' "$work/locations.conf"; echo '}'; } > "$work/nginx.conf"
  docker rm -f "$proxy" >/dev/null 2>&1 || true
  docker run -d --name "$proxy" --network "${COMPOSE_PROJECT_NAME}_default" --pull missing -q \
    -v "$work/nginx.conf:/etc/nginx/conf.d/default.conf:ro" "$proxy_image" >/dev/null || fail "nginx did not start"
  for _ in $(seq 1 40); do
    [ "$(through_proxy "$2")" = 200 ] && return 0
    sleep 0.25
  done
  fail "nginx did not answer $2: $(docker logs "$proxy" 2>&1 | tail -5)"
}

# The status GET $1 ends with through the proxy, redirects followed, from inside its container.
through_proxy() {
  docker exec "$proxy" wget -q -S -O /dev/null "http://localhost:8080$1" 2>&1 \
    | sed -nE 's/^ *HTTP\/1\.[01] ([0-9]+).*/\1/p' | tail -1
}

echo "== synthetic export"
scripts/synthetic-export --own-text "$work/export.sqlite"

echo "== docker compose up (image $FRUS_IMAGE)"
docker compose up -d frus   # the optional pdf service needs no test
wait_for_200 "$base/healthz" 30 || fail "/healthz did not answer 200"

echo "== user, filesystem and network"
container=$(docker compose ps -q frus)
uid=$(docker compose exec -T frus id -u)
[ "$uid" = 10001 ] || fail "the server runs as UID $uid, not 10001"
# As root, so the checks test the mounts rather than the server user's permissions.
[ "$(docker inspect --format '{{.HostConfig.ReadonlyRootfs}}' "$container")" = true ] || fail "the root filesystem is not read-only"
if docker compose exec -T -u 0 frus touch /probe 2>/dev/null; then fail "root can write to the root filesystem"; fi
docker compose exec -T frus sh -c 'touch /data/probe && rm /data/probe && touch /tmp/probe' || fail "/data or /tmp is not writable"
docker compose exec -T frus test -r /data/volumes/frus1894Nicaragua.xml || fail "the TEI folder is not mounted"
if docker compose exec -T -u 0 frus touch /data/volumes/probe 2>/dev/null; then fail "the TEI folder is writable"; fi
published=$(docker compose port frus 8080)
[ "${published%:*}" = 127.0.0.1 ] || fail "the port is published on $published, not 127.0.0.1"
echo "   UID 10001; root read-only; /data and /tmp writable; TEI read-only; port on 127.0.0.1"

echo "== the browser app"
# The app's page and every client route answer with the same index.html and the app's policy; a
# missing file and an unknown API path do not.
app=$(curl -s --max-time 5 -D "$work/app.headers" -o "$work/app.html" -w '%{http_code} %{content_type}' "$base/" || true)
[ "$app" = "200 text/html; charset=utf-8" ] || fail "/ answered $app"
grep -qi "^content-security-policy: default-src 'self'" "$work/app.headers" || fail "/ has no content security policy"
grep -qi '^cache-control: no-cache' "$work/app.headers" || fail "/ may be cached"
grep -q '<base href="/" />' "$work/app.html" || fail "/ has no <base href=\"/\">"
grep -Eq '<script type="module"[^>]* src="\./assets/[^"]+\.js"' "$work/app.html" || fail "/ does not load the app's script"
if grep -Eq '<script( type="module")?>' "$work/app.html"; then fail "/ has an inline script the policy would block"; fi
for path in "/search?keywords=treaties" "/doc/frus1961-63v06/d1"; do
  curl -s --max-time 5 -o "$work/route.html" "$base$path" || fail "$path did not answer"
  cmp -s "$work/app.html" "$work/route.html" || fail "$path is not the app's page"
done
script=$(sed -nE 's/.*<script type="module"[^>]* src="([^"]+)".*/\1/p' "$work/app.html" | head -1)
curl -s --max-time 5 -D "$work/script.headers" -o /dev/null "$base/${script#./}" || fail "$script did not answer"
grep -qi '^cache-control: public, max-age=31536000, immutable' "$work/script.headers" || fail "$script is not cached as immutable"
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base/assets/no-such-file.js" || true)
[ "$code" = 404 ] || fail "a missing asset answered $code"
unknown=$(curl -s --max-time 5 -o /dev/null -w '%{http_code} %{content_type}' "$base/api/v1/no-such-endpoint" || true)
[ "$unknown" = "404 application/problem+json" ] || fail "an unknown API path answered $unknown"
echo "   / and two client routes give index.html with the app's policy; $script immutable; 404s for a missing asset and an unknown API path"

echo "== before an import"
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base/readyz" || true)
[ "$code" = 503 ] || fail "/readyz answered $code before any import"
echo "   503 waiting_for_export"
# The catalogue comes from the image's copy of the app's data files, and the reader from the
# mounted TEI; neither needs an index.
volumes=$(curl -s --max-time 5 "$base/api/v1/volumes?limit=1") || fail "/api/v1/volumes did not answer"
printf '%s' "$volumes" | grep -q '"total":553' || fail "the catalogue does not list 553 volumes: $volumes"
reader=$(curl -s --max-time 30 -o "$work/d1.html" -w '%{http_code} %{content_type}' \
  "$base/api/v1/volumes/frus1894Nicaragua/documents/d1/html?part=body" || true)
[ "$reader" = "200 text/html; charset=utf-8" ] || fail "the reader answered $reader: $(head -c 300 "$work/d1.html")"
missing=$(curl -s --max-time 5 -w ' %{http_code}' "$base/api/v1/volumes/frus1961-63v99" || true)
case "$missing" in *'"code":"VOLUME_NOT_FOUND"'*' 404') ;; *) fail "an unknown volume answered $missing" ;; esac
echo "   catalogue of 553 volumes; frus1894Nicaragua d1 rendered, $(wc -c < "$work/d1.html" | tr -d ' ') bytes; problem details for an unknown volume"

echo "== docker compose cp the export, then /readyz"
docker compose cp "$work/export.sqlite" frus:/data/import/export.sqlite
wait_for_200 "$base/readyz" 120 || fail "/readyz did not reach 200"
status=$(curl -s --max-time 5 "$base/api/v1/status") || fail "/api/v1/status did not answer"
printf '%s' "$status" | grep -q '"documents":7' || fail "status does not report 7 documents: $status"
echo "   status: $(printf '%s' "$status" | sed -nE 's/.*"sqliteVersion":"([^"]+)".*/SQLite \1/p'), 7 documents"

echo "== the image's labels"
# The app build whose exports the image serves, and the index version, which a release names
# (PLAN's S14g): the index version is the one the server serves.
label() { docker image inspect --format "{{ index .Config.Labels \"$1\" }}" "$FRUS_IMAGE"; }
ns=io.github.joshbotts.frus-explorer
app_version=$(label "$ns.version")
app_build=$(label "$ns.build")
labelled=$(label "$ns.index-version")
served=$(printf '%s' "$status" | sed -nE 's/.*"supportedIndexVersion":([0-9]+).*/\1/p')
[[ $app_version =~ ^[0-9]+(\.[0-9]+)*$ && $app_build =~ ^[0-9]+$ ]] \
  || fail "the image's labels name no app build: version \"$app_version\", build \"$app_build\""
[ "$labelled" = "$served" ] || fail "the image's index-version label is \"$labelled\", where the server serves ${served:-none}"
echo "   FRUS Explorer $app_version (build $app_build), index version $labelled, the one the server serves"

echo "== search and the reader's page over the imported index"
# The kit's read-only stack over the live index: two documents mention treaties.
search=$(curl -s --max-time 30 "$base/api/v1/search?keywords=treaties") || fail "/api/v1/search did not answer"
# The keys come in no fixed order, so the count may end the object.
printf '%s' "$search" | grep -Eq '"total":2[,}]' || fail "the search did not find 2 documents: $search"
page=$(curl -s --max-time 30 -D "$work/page.headers" -o "$work/page.html" -w '%{http_code} %{content_type}' \
  "$base/api/v1/volumes/frus1961-63v06/documents/d1/html" || true)
[ "$page" = "200 text/html; charset=utf-8" ] || fail "the reader's page answered $page: $(head -c 300 "$work/page.html")"
grep -q '<script src="/reader/host.js" defer></script>' "$work/page.html" || fail "the page does not load the host script"
grep -qi "^content-security-policy: default-src 'none'" "$work/page.headers" || fail "the page has no content security policy"
host=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base/reader/host.js" || true)
[ "$host" = 200 ] || fail "/reader/host.js answered $host"
echo "   2 documents found; frus1961-63v06 d1's page, $(wc -c < "$work/page.html" | tr -d ' ') bytes, with its host script and policy"

echo "== the user's tags, through the write guard"
# Sent to the public address's host and from its origin, as the browser app sends them; curl
# reaches the server on the host's port, so it names the host the browser would.
as_app=(-H "Host: localhost:8080" -H "Origin: http://localhost:8080")
me=$(curl -s --max-time 5 "${as_app[@]}" "$base/api/v1/me") || fail "/api/v1/me did not answer"
token=$(printf '%s' "$me" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p')
[ -n "$token" ] || fail "/api/v1/me gave no token: $me"
refused() {  # $1: the code expected; the rest: curl's arguments
  local expected=$1 answer
  shift
  answer=$(curl -s --max-time 5 -X POST -H 'Content-Type: application/json' --data '{"name":"Smoke"}' "$@" \
    -w ' %{http_code}' "$base/api/v1/me/tags" || true)
  case "$answer" in *"\"code\":\"$expected\""*' 403') ;; *) fail "a write that should be $expected answered $answer" ;; esac
}
refused CSRF_TOKEN_INVALID "${as_app[@]}"
refused ORIGIN_NOT_ALLOWED -H "Host: localhost:8080" -H "Origin: https://attacker.example" -H "X-CSRF-Token: $token"
refused HOST_NOT_ALLOWED -H "Host: attacker.example:8080" -H "Origin: http://localhost:8080" -H "X-CSRF-Token: $token"
made=$(curl -s --max-time 5 -X POST "${as_app[@]}" -H "X-CSRF-Token: $token" -H 'Content-Type: application/json' \
  --data '{"name":"  Smoke  "}' -w ' %{http_code}' "$base/api/v1/me/tags") || fail "the tag was not made"
case "$made" in *'"name":"Smoke"'*' 201') ;; *) fail "making a tag answered $made" ;; esac
tag=$(printf '%s' "$made" | sed -nE 's/.*"id":"([0-9A-F-]+)".*/\1/p')
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' -X DELETE "${as_app[@]}" -H "X-CSRF-Token: $token" \
  "$base/api/v1/me/tags/$tag" || true)
[ "$code" = 204 ] || fail "deleting the tag answered $code"
echo "   refused without the token, from another origin and to another host; made Smoke, trimmed, and deleted it"

echo "== behind nginx at the root, with docs/INSTALL.md's recipe"
start_proxy "at the root" /healthz
for path in / "/doc/frus1961-63v06/d1" /api/v1/status "/api/v1/volumes/frus1961-63v06/documents/d1/html" /reader/host.js /readyz; do
  code=$(through_proxy "$path")
  [ "$code" = 200 ] || fail "$path answered $code through nginx"
done
echo "   the app, a client route, the API, the reader's page and its host script, and /readyz"

if [ -n "$e2e" ]; then
  echo "== the browser suite at the root: Playwright on Chromium"
  # In the server's network namespace, so the app is http://localhost:8080, a secure context.
  FRUS_E2E_NETWORK="container:$container" FRUS_E2E_BASE_URL=http://localhost:8080/ scripts/npm --playwright \
    || fail "the browser suite failed; web/playwright-report has its report"
fi

# Waits up to a minute for the container's health check to pass.
wait_healthy() {
  local health=""
  for _ in $(seq 1 60); do
    health=$(docker inspect --format '{{.State.Health.Status}}' "$container")
    [ "$health" = healthy ] && return 0
    sleep 1
  done
  fail "the container's health is $health"
}

echo "== health check"
wait_healthy
echo "   healthy"

echo "== restart: the index stays in the volume"
docker compose restart frus >/dev/null
wait_for_200 "$base/readyz" 60 || fail "/readyz did not reach 200 after a restart"

echo "== under a path: FRUS_PUBLIC_URL ends in /frus-explorer/"
# The container is made again with the path, and the index stays in the volume. /healthz and
# /readyz answer at the root as well, so Docker's health check is unchanged.
FRUS_PUBLIC_URL=http://localhost:8080/frus-explorer/ docker compose up -d frus 2>/dev/null
container=$(docker compose ps -q frus)
under="$base/frus-explorer"
wait_for_200 "$base/readyz" 60 || fail "/readyz did not reach 200 at the root under a path"
wait_for_200 "$under/readyz" 5 || fail "/frus-explorer/readyz did not answer 200"
app=$(curl -s --max-time 5 -o "$work/under.html" -w '%{http_code} %{content_type}' "$under/" || true)
[ "$app" = "200 text/html; charset=utf-8" ] || fail "/frus-explorer/ answered $app"
grep -q '<base href="/frus-explorer/" />' "$work/under.html" || fail "/frus-explorer/ does not write its path into <base>"
curl -s --max-time 5 -o "$work/route.html" "$under/doc/frus1961-63v06/d1" || fail "a client route did not answer"
cmp -s "$work/under.html" "$work/route.html" || fail "a client route under the path is not the app's page"
script=$(sed -nE 's/.*<script type="module"[^>]* src="([^"]+)".*/\1/p' "$work/under.html" | head -1)
curl -s --max-time 5 -D "$work/script.headers" -o /dev/null "$under/${script#./}" || fail "$script did not answer"
grep -qi '^cache-control: public, max-age=31536000, immutable' "$work/script.headers" || fail "$script under the path is not the app's"
status=$(curl -s --max-time 5 "$under/api/v1/status") || fail "/frus-explorer/api/v1/status did not answer"
printf '%s' "$status" | grep -q '"documents":7' || fail "status under the path does not report 7 documents: $status"
curl -s --max-time 30 -o "$work/page.html" "$under/api/v1/volumes/frus1961-63v06/documents/d1/html" || fail "the reader's page did not answer"
grep -q '<script src="/frus-explorer/reader/host.js" defer></script>' "$work/page.html" || fail "the page does not name its host script under the path"
for path in /frus-explorer/healthz /frus-explorer/reader/host.js; do
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base$path" || true)
  [ "$code" = 200 ] || fail "$path answered $code"
done
redirect=$(curl -s --max-time 5 -o /dev/null -w '%{http_code} %{redirect_url}' "$base/frus-explorer" || true)
[ "$redirect" = "308 $base/frus-explorer/" ] || fail "/frus-explorer answered $redirect"
for path in /search /api/v1/status "/${script#./}"; do
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base$path" || true)
  [ "$code" = 404 ] || fail "$path, outside the path, answered $code"
done
echo "   the page with its base, a client route, $script, the API, the reader's page and host script under the path; health at both; 404 outside it"

echo "== behind nginx under the path, with docs/INSTALL.md's recipe"
start_proxy "under a path" /frus-explorer/healthz
for path in /frus-explorer /frus-explorer/ "/frus-explorer/search?keywords=treaties" /frus-explorer/api/v1/status /frus-explorer/reader/host.js /frus-explorer/readyz; do
  code=$(through_proxy "$path")
  [ "$code" = 200 ] || fail "$path answered $code through nginx"
done
echo "   the app, its own path without the slash, a client route, the API, the host script and /readyz"

if [ -n "$e2e" ]; then
  echo "== the browser suite under the path, through nginx: Playwright on Chromium"
  # In the proxy's network namespace, so the app is http://localhost:8080/frus-explorer/.
  FRUS_E2E_NETWORK="container:$proxy" FRUS_E2E_BASE_URL=http://localhost:8080/frus-explorer/ scripts/npm --playwright \
    || fail "the browser suite failed under the path; web/playwright-report has its report"
fi

echo "== health check under the path"
wait_healthy
echo "   healthy"

passed=1
echo "PASS: compose smoke test"
