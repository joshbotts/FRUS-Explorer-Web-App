library_idle 60 || fail "the check did not end: $(head -c 400 "$work/library-jobs.json")"
python3 - "$work/library-jobs.json" "$work/index-room.json" <<'PY' || fail "the compaction or the check did not end well: $(head -c 800 "$work/library-jobs.json")"
import json, sys
jobs = json.load(open(sys.argv[1], encoding="utf-8"))["jobs"]
compaction = next(j for j in jobs if j["kind"] == "indexCompact")
check = next(j for j in jobs if j["kind"] == "indexCheck")
removals = [j for j in jobs if j["kind"] == "libraryRemove"]
assert len(removals) == 2 and all(j["state"] == "succeeded" for j in removals), removals
assert compaction["state"] == "succeeded" and compaction["progress"].startswith("Compacted the index from"), compaction
assert check["state"] == "succeeded" and check["progress"].startswith("The index's check found no problems"), check
print(f"   the side-loaded volumes removed from the index and the library; {compaction['progress']} {check['progress']}")
PY
curl -s --max-time 10 -H "Host: localhost:8080" -o "$work/index-room.json" "$library_base/api/v1/admin/index"
counts=$(library_counts 2>/dev/null || true)
