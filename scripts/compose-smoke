ve09 = volumes["frus1969-76ve09p1"]
assert ve09["status"] == "downloaded" and not ve09["indexed"] and "index" not in ve09, ve09' "$work/library.json" \
  || fail "the seeded index's volume is not listed as indexed, or a volume it lacks as downloaded alone"
