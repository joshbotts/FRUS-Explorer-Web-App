draft = volumes["smoke-draft"]
assert draft["sideloaded"] and draft["status"] == "indexed" and draft["downloaded"] and "Nicaragua" in draft["title"], draft' "$work/library.json" \
  || fail "the side-loaded volume is not listed, indexed: $(grep -o '"volumeId":"smoke-draft"[^}]*' "$work/library.json" | head -c 400)"
curl -s --max-time 10 -o "$work/draft-citation.json" "$library_base/api/v1/volumes/smoke-draft/documents/d1/citation"
python3 -c 'import json, sys
