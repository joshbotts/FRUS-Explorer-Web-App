#!/usr/bin/env bash
# FRUS Explorer Light: the Compose smoke test (session 5).
# Starts compose.yaml's server, checks the browser app, the catalogue and the reader before any
# import, imports a synthetic export with docker compose cp, and waits for /readyz to answer 200;
# then checks the image's labels against the server's status, searches the index, reads a
# document's page, makes and deletes a tag through the API's write guard (PLAN's S14c), and checks
# the user, the read-only root, the health check and a restart. Then it
# makes the container again with FRUS_PUBLIC_URL ending in /frus-explorer/ and checks the server
# under that path (PLAN's S14f), where it imports a Mac JSON export of more than 4 MiB through
# nginx (S16c), then an export made with the owner's writing, whose installed index
# scripts/check-stripped-export searches for it, and one whose strip outgrows a 64 KB /tmp, in a
# container of its own (S16e). Then it backs up the user store with frus-light backup, fetches the
# backup through GET /api/v1/admin/backup, removes the store, restores it with frus-light restore and
# reads the same research back (S14b). docs/INSTALL.md's nginx recipes, for the root and for a path,
# run in nginx on the Compose network in each phase. Then the server signs people in with accounts of
# its own (S20b), FRUS_AUTH=local, two made with frus-light user, whose sessions, refusals and slowing
# it checks. Last, the server signs people in through the
# proxy (S14e), with FRUS_AUTH=header and nginx's address alone in FRUS_TRUSTED_PROXIES: the install
# guide's recipe for it runs with a stand-in for its session check, a header from outside the list
# is refused, and two users' tags stay apart. Its TEI folder holds fixtures/tei's volumes and the
# kit's fixture for a section's own text,
# fixtures/own-text/frus1969-76v01.xml, whose rows the export holds too. Between the research steps and
# nginx at the root it starts the pdf profile, once, for the rest of the run: before it, the server
# offers no PDF; with it, a collection's PDF comes through Gotenberg's Chromium and holds the titles its
# HTML export gives its documents, which scripts/pdf-text reads, and the browser suite exports one by
# keyboard (PLAN's S25a). It needs python3, for scripts/pdf-text.
#   scripts/compose-smoke                       builds the image as frus-light:smoke first
#   FRUS_IMAGE=<image> scripts/compose-smoke    tests an image already built
#   scripts/compose-smoke --e2e                 also runs web/e2e, Playwright on Chromium, against the
#                                               imported server at the root, then under the path
#                                               through nginx, its accounts spec with local
#                                               accounts, and its sign-in spec through the
#                                               proxy that signs people in (scripts/npm ci first)
# It uses its own Compose project and host port, and removes its containers and volume afterwards.
# Each step's line names its area, as web/src/router.tsx and copy.ts group theirs: the install (the
# image, Compose, the proxy's recipes and the health check), browse and search, the reader, research,
# settings and admin, and all areas for the browser suite. A row adds its step beside its area's kin,
# in the phase whose state the step needs, never at the end (PLAN, How sessions run beside each
# other, rule 4).
set -euo pipefail

e2e=""
case "${1:-}" in
  --e2e) e2e=1 ;;
  "") ;;
  *) echo "usage: scripts/compose-smoke [--e2e]" >&2; exit 2 ;;
esac

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
if ! command -v docker >/dev/null 2>&1 && [ -x "$HOME/.docker/bin/docker" ]; then
  PATH="$HOME/.docker/bin:$PATH"
fi

export COMPOSE_PROJECT_NAME="frus-smoke-$$"
export FRUS_HOST_PORT="${FRUS_HOST_PORT:-18080}"
# The address the browser suite opens, in the server's network namespace: a change must come from
# it and be sent to it (PLAN's S14c). curl reaches the same server on the host's port.
export FRUS_PUBLIC_URL=http://localhost:8080
if [ -z "${FRUS_IMAGE:-}" ]; then
  export FRUS_IMAGE=frus-light:smoke
  echo "== install: building $FRUS_IMAGE"
  build_args=()
  while IFS= read -r arg; do build_args+=(--build-arg "$arg"); done < <(scripts/release build-args)
  docker build -f docker/Dockerfile "${build_args[@]}" -t "$FRUS_IMAGE" .
fi
base="http://127.0.0.1:$FRUS_HOST_PORT"
proxy="$COMPOSE_PROJECT_NAME-proxy"
proxy_image=nginx:1.28-alpine
work=$(mktemp -d)
passed=""
mkdir "$work/tei"
cp fixtures/tei/*.xml fixtures/own-text/frus1969-76v01.xml "$work/tei/"
export FRUS_TEI_DIR="$work/tei"
# The host folder each backup is copied to (S14b), which the server's user, UID 10001, must be able
# to write: docs/INSTALL.md has a Linux host chown it, and Docker Desktop lets any user write one.
mkdir "$work/backups"
chmod 0777 "$work/backups"
export FRUS_BACKUP_DIR="$work/backups"
# The daily backup's hour is the container's time zone's, which the image's own data must know.
export TZ=America/New_York

cleanup() {
  if [ -z "$passed" ]; then
    echo "== the smoke test failed; the server's log:"
    docker compose logs --no-color frus 2>&1 | tail -50 || true
    # Gotenberg's, once a step has started it: a print it refuses names its cause there alone.
    if [ -n "$(COMPOSE_PROFILES=pdf docker compose ps -aq pdf 2>/dev/null)" ]; then
      echo "== the pdf service's log:"
      COMPOSE_PROFILES=pdf docker compose logs --no-color pdf 2>&1 | tail -40 || true
    fi
  fi
  docker rm -f "$proxy" "$COMPOSE_PROJECT_NAME-tmp-volume" "$COMPOSE_PROJECT_NAME-tmp-tmp" "$COMPOSE_PROJECT_NAME-keyless" >/dev/null 2>&1 || true
  docker volume rm "$COMPOSE_PROJECT_NAME-tmp-volume" "$COMPOSE_PROJECT_NAME-tmp-tmp" >/dev/null 2>&1 || true
  # With the pdf profile, whether or not a step started it, so that its container and network go too.
  COMPOSE_PROFILES=pdf docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }

# Waits up to $2 seconds for $1 to answer 200, printing each new readiness step it sees.
wait_for_200() {
  local url=$1 seconds=$2 last="" code body step
  for _ in $(seq 1 $((seconds * 4))); do
    body=$(curl -s --max-time 5 -w '\n%{http_code}' "$url" 2>/dev/null || true)
    code=${body##*$'\n'}
    step=$(printf '%s' "${body%$'\n'*}" | sed -nE 's/.*"step":"([a-z_]+)".*/\1/p')
    if [ -n "$step" ] && [ "$step" != "$last" ]; then echo "   $code $step"; last=$step; fi
    [ "$code" = 200 ] && return 0
    sleep 0.25
  done
  return 1
}

# Starts nginx on the Compose network with docs/INSTALL.md's recipe $1, "at the root", "under a
# path" or "signing in": its location blocks in a server on port 8080, IPv4 and IPv6, since
# localhost is ::1 first in its container, whose upstream is the frus service, and after it the
# configuration in the file $3, if given. Waits for $2, a path the recipe forwards, to answer 200
# through it.
start_proxy() {
  awk -v marker="<!-- compose-smoke: nginx $1 -->" '$0 == marker {found = 1; next}
    found && /^```nginx$/ {copy = 1; next} copy && /^```$/ {exit} copy' docs/INSTALL.md > "$work/locations.conf"
  [ -s "$work/locations.conf" ] || fail "docs/INSTALL.md has no nginx recipe $1"
  { echo 'server {'; echo '    listen 8080;'; echo '    listen [::]:8080;'; sed 's|http://127\.0\.0\.1:8080|http://frus:8080|' "$work/locations.conf"; echo '}'
    if [ -n "${3:-}" ]; then cat "$3"; fi; } > "$work/nginx.conf"
  docker rm -f "$proxy" >/dev/null 2>&1 || true
  docker run -d --name "$proxy" --network "${COMPOSE_PROJECT_NAME}_default" --pull missing -q \
    -v "$work/nginx.conf:/etc/nginx/conf.d/default.conf:ro" "$proxy_image" >/dev/null || fail "nginx did not start"
  for _ in $(seq 1 40); do
    [ "$(through_proxy "$2")" = 200 ] && return 0
    sleep 0.25
  done
  fail "nginx did not answer $2: $(docker logs "$proxy" 2>&1 | tail -5)"
}

# The status GET $1 ends with through the proxy, redirects followed, from inside its container.
through_proxy() {
  docker exec "$proxy" wget -q -S -O /dev/null "http://localhost:8080$1" 2>&1 \
    | sed -nE 's/^ *HTTP\/1\.[01] ([0-9]+).*/\1/p' | tail -1
}

echo "== admin: a synthetic export"
scripts/synthetic-export --own-text "$work/export.sqlite"

echo "== install: docker compose up (image $FRUS_IMAGE)"
docker compose up -d frus   # the optional pdf service needs no test
wait_for_200 "$base/healthz" 30 || fail "/healthz did not answer 200"

echo "== install: user, filesystem and network"
container=$(docker compose ps -q frus)
uid=$(docker compose exec -T frus id -u)
[ "$uid" = 10001 ] || fail "the server runs as UID $uid, not 10001"
# As root, so the checks test the mounts rather than the server user's permissions.
[ "$(docker inspect --format '{{.HostConfig.ReadonlyRootfs}}' "$container")" = true ] || fail "the root filesystem is not read-only"
if docker compose exec -T -u 0 frus touch /probe 2>/dev/null; then fail "root can write to the root filesystem"; fi
docker compose exec -T frus sh -c 'touch /data/probe && rm /data/probe && touch /tmp/probe' || fail "/data or /tmp is not writable"
docker compose exec -T frus sh -c 'touch /backups/probe && rm /backups/probe' || fail "the backups folder is not writable"
docker compose exec -T frus test -r /data/volumes/frus1894Nicaragua.xml || fail "the TEI folder is not mounted"
if docker compose exec -T -u 0 frus touch /data/volumes/probe 2>/dev/null; then fail "the TEI folder is writable"; fi
published=$(docker compose port frus 8080)
[ "${published%:*}" = 127.0.0.1 ] || fail "the port is published on $published, not 127.0.0.1"
echo "   UID 10001; root read-only; /data, /backups and /tmp writable; TEI read-only; port on 127.0.0.1"

echo "== admin: the daily backup's first look"
# At its start the server looks at its backups, and finds a new store that holds no research yet,
# which it does not back up: its first backup comes at the look after the first write (S14b).
looked=""
for _ in $(seq 1 60); do
  looked=$(docker compose logs --no-color frus 2>&1 | grep -c "app.db holds no research yet, so no backup was taken" || true)
  [ "$looked" -gt 0 ] && break
  sleep 0.25
done
[ "$looked" -gt 0 ] || fail "the server did not look at its backups: $(docker compose logs --no-color frus 2>&1 | grep -i backup | tail -3)"
[ -z "$(ls -A "$work/backups")" ] || fail "a new store was backed up: $(ls "$work/backups")"
# The whole log first: grep -q would stop reading it at its match, and under pipefail the writer's
# broken pipe would fail the check.
server_log=$(docker compose logs --no-color frus 2>&1)
case "$server_log" in *"backed up daily at 03:00 America/New_York"*) ;;
  *) fail "the server does not name the backup's hour in TZ's time zone: $(printf '%s\n' "$server_log" | grep -i 'backed up daily' | tail -1)" ;;
esac
echo "   none of a new store; daily at 03:00 America/New_York"

echo "== install: the browser app"
# The app's page and every client route answer with the same index.html and the app's policy; a
# missing file and an unknown API path do not.
app=$(curl -s --max-time 5 -D "$work/app.headers" -o "$work/app.html" -w '%{http_code} %{content_type}' "$base/" || true)
[ "$app" = "200 text/html; charset=utf-8" ] || fail "/ answered $app"
grep -qi "^content-security-policy: default-src 'self'" "$work/app.headers" || fail "/ has no content security policy"
grep -qi '^cache-control: no-cache' "$work/app.headers" || fail "/ may be cached"
grep -q '<base href="/" />' "$work/app.html" || fail "/ has no <base href=\"/\">"
grep -Eq '<script type="module"[^>]* src="\./assets/[^"]+\.js"' "$work/app.html" || fail "/ does not load the app's script"
if grep -Eq '<script( type="module")?>' "$work/app.html"; then fail "/ has an inline script the policy would block"; fi
for path in "/search?keywords=treaties" "/doc/frus1961-63v06/d1"; do
  curl -s --max-time 5 -o "$work/route.html" "$base$path" || fail "$path did not answer"
  cmp -s "$work/app.html" "$work/route.html" || fail "$path is not the app's page"
done
script=$(sed -nE 's/.*<script type="module"[^>]* src="([^"]+)".*/\1/p' "$work/app.html" | head -1)
curl -s --max-time 5 -D "$work/script.headers" -o /dev/null "$base/${script#./}" || fail "$script did not answer"
grep -qi '^cache-control: public, max-age=31536000, immutable' "$work/script.headers" || fail "$script is not cached as immutable"
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base/assets/no-such-file.js" || true)
[ "$code" = 404 ] || fail "a missing asset answered $code"
unknown=$(curl -s --max-time 5 -o /dev/null -w '%{http_code} %{content_type}' "$base/api/v1/no-such-endpoint" || true)
[ "$unknown" = "404 application/problem+json" ] || fail "an unknown API path answered $unknown"
echo "   / and two client routes give index.html with the app's policy; $script immutable; 404s for a missing asset and an unknown API path"

echo "== browse and search, the reader: before an import"
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base/readyz" || true)
[ "$code" = 503 ] || fail "/readyz answered $code before any import"
echo "   503 waiting_for_export"
# The catalogue comes from the image's copy of the app's data files, and the reader from the
# mounted TEI; neither needs an index.
volumes=$(curl -s --max-time 5 "$base/api/v1/volumes?limit=1") || fail "/api/v1/volumes did not answer"
printf '%s' "$volumes" | grep -q '"total":553' || fail "the catalogue does not list 553 volumes: $volumes"
reader=$(curl -s --max-time 30 -o "$work/d1.html" -w '%{http_code} %{content_type}' \
  "$base/api/v1/volumes/frus1894Nicaragua/documents/d1/html?part=body" || true)
[ "$reader" = "200 text/html; charset=utf-8" ] || fail "the reader answered $reader: $(head -c 300 "$work/d1.html")"
missing=$(curl -s --max-time 5 -w ' %{http_code}' "$base/api/v1/volumes/frus1961-63v99" || true)
case "$missing" in *'"code":"VOLUME_NOT_FOUND"'*' 404') ;; *) fail "an unknown volume answered $missing" ;; esac
echo "   catalogue of 553 volumes; frus1894Nicaragua d1 rendered, $(wc -c < "$work/d1.html" | tr -d ' ') bytes; problem details for an unknown volume"

echo "== admin: docker compose cp the export, then /readyz"
docker compose cp "$work/export.sqlite" frus:/data/import/export.sqlite
wait_for_200 "$base/readyz" 120 || fail "/readyz did not reach 200"
status=$(curl -s --max-time 5 "$base/api/v1/status") || fail "/api/v1/status did not answer"
printf '%s' "$status" | grep -q '"documents":7' || fail "status does not report 7 documents: $status"
echo "   status: $(printf '%s' "$status" | sed -nE 's/.*"sqliteVersion":"([^"]+)".*/SQLite \1/p'), 7 documents"

echo "== admin: the import's job (PLAN's S20d)"
# The export the drop zone took ran as a job of the server's queue, which the admin's list names,
# finished, asked for by the server itself; the admin step on local accounts finds it again, after the
# restarts between, since the queue keeps its jobs in the user store.
# /readyz turns 200 as the job installs the index, a moment before the job itself has finished.
import_job=""
for _ in $(seq 1 20); do
  jobs=$(curl -s --max-time 5 -H "Host: localhost:8080" "$base/api/v1/admin/jobs") || fail "/api/v1/admin/jobs did not answer"
  import_job=$(python3 -c 'import json, sys
jobs = [j for j in json.loads(sys.argv[1])["jobs"] if j["kind"] == "indexImport" and j.get("subject") == "export.sqlite"]
print(jobs[0]["id"] if len(jobs) == 1 and jobs[0]["state"] == "succeeded" and "requestedBy" not in jobs[0] else "")' "$jobs") \
    || fail "the jobs list is not one: $jobs"
  [ -n "$import_job" ] && break
  sleep 0.25
done
[ -n "$import_job" ] || fail "the jobs list does not name the import's job, finished: $jobs"
echo "   job $import_job, the index import of export.sqlite, finished"

echo "== install: the image's labels"
# The app build whose exports the image serves, and the index version, which a release names
# (PLAN's S14g): the index version is the one the server serves.
label() { docker image inspect --format "{{ index .Config.Labels \"$1\" }}" "$FRUS_IMAGE"; }
ns=io.github.joshbotts.frus-explorer
app_version=$(label "$ns.version")
app_build=$(label "$ns.build")
labelled=$(label "$ns.index-version")
served=$(printf '%s' "$status" | sed -nE 's/.*"supportedIndexVersion":([0-9]+).*/\1/p')
[[ $app_version =~ ^[0-9]+(\.[0-9]+)*$ && $app_build =~ ^[0-9]+$ ]] \
  || fail "the image's labels name no app build: version \"$app_version\", build \"$app_build\""
[ "$labelled" = "$served" ] || fail "the image's index-version label is \"$labelled\", where the server serves ${served:-none}"
echo "   FRUS Explorer $app_version (build $app_build), index version $labelled, the one the server serves"

echo "== browse and search, the reader: search and the reader's page over the imported index"
# The kit's read-only stack over the live index: two documents mention treaties.
search=$(curl -s --max-time 30 "$base/api/v1/search?keywords=treaties") || fail "/api/v1/search did not answer"
# The keys come in no fixed order, so the count may end the object.
printf '%s' "$search" | grep -Eq '"total":2[,}]' || fail "the search did not find 2 documents: $search"
page=$(curl -s --max-time 30 -D "$work/page.headers" -o "$work/page.html" -w '%{http_code} %{content_type}' \
  "$base/api/v1/volumes/frus1961-63v06/documents/d1/html" || true)
[ "$page" = "200 text/html; charset=utf-8" ] || fail "the reader's page answered $page: $(head -c 300 "$work/page.html")"
grep -qi "^content-security-policy: default-src 'none'" "$work/page.headers" || fail "the page has no content security policy"
# The app's three reader scripts, from the kit, then the host script, each the server's own file.
for file in frus-offset-engine.js frus-highlights.js frus-selection.js host.js; do
  grep -q "<script src=\"/reader/$file\" defer></script>" "$work/page.html" || fail "the page does not load /reader/$file"
  answer=$(curl -s --max-time 5 -o /dev/null -w '%{http_code} %{content_type}' "$base/reader/$file" || true)
  [ "$answer" = "200 text/javascript; charset=utf-8" ] || fail "/reader/$file answered $answer"
done
# The kit's rendering version of d1's text, which a new highlight's request names; a header line ends in CR.
version=$(grep -i '^x-frus-rendering-version:' "$work/page.headers" | tr -d '\r' | cut -d' ' -f2)
[ "${#version}" = 16 ] || fail "the page sends no rendering version: '$version'"
echo "   2 documents found; frus1961-63v06 d1's page, $(wc -c < "$work/page.html" | tr -d ' ') bytes, with the reader's four scripts and its policy"

echo "== research: the user's tags, through the write guard"
# Sent to the public address's host and from its origin, as the browser app sends them; curl
# reaches the server on the host's port, so it names the host the browser would.
as_app=(-H "Host: localhost:8080" -H "Origin: http://localhost:8080")
me=$(curl -s --max-time 5 "${as_app[@]}" "$base/api/v1/me") || fail "/api/v1/me did not answer"
token=$(printf '%s' "$me" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p')
[ -n "$token" ] || fail "/api/v1/me gave no token: $me"
refused() {  # $1: the code expected; the rest: curl's arguments
  local expected=$1 answer
  shift
  answer=$(curl -s --max-time 5 -X POST -H 'Content-Type: application/json' --data '{"name":"Smoke"}' "$@" \
    -w ' %{http_code}' "$base/api/v1/me/tags" || true)
  case "$answer" in *"\"code\":\"$expected\""*' 403') ;; *) fail "a write that should be $expected answered $answer" ;; esac
}
refused CSRF_TOKEN_INVALID "${as_app[@]}"
refused ORIGIN_NOT_ALLOWED -H "Host: localhost:8080" -H "Origin: https://attacker.example" -H "X-CSRF-Token: $token"
refused HOST_NOT_ALLOWED -H "Host: attacker.example:8080" -H "Origin: http://localhost:8080" -H "X-CSRF-Token: $token"
made=$(curl -s --max-time 5 -X POST "${as_app[@]}" -H "X-CSRF-Token: $token" -H 'Content-Type: application/json' \
  --data '{"name":"  Smoke  "}' -w ' %{http_code}' "$base/api/v1/me/tags") || fail "the tag was not made"
case "$made" in *'"name":"Smoke"'*' 201') ;; *) fail "making a tag answered $made" ;; esac
tag=$(printf '%s' "$made" | sed -nE 's/.*"id":"([0-9A-F-]+)".*/\1/p')
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' -X DELETE "${as_app[@]}" -H "X-CSRF-Token: $token" \
  "$base/api/v1/me/tags/$tag" || true)
[ "$code" = 204 ] || fail "deleting the tag answered $code"
echo "   refused without the token, from another origin and to another host; made Smoke, trimmed, and deleted it"

echo "== research: a highlight, through the write guard"
# Over d1's first nine characters, in the version of the page read above; the server takes its text
# from the page's model. Then the document lists it, and it is removed.
highlights="$base/api/v1/me/volumes/frus1961-63v06/documents/d1/highlights"
made=$(curl -s --max-time 30 -X POST "${as_app[@]}" -H "X-CSRF-Token: $token" -H 'Content-Type: application/json' \
  --data "{\"startOffset\":0,\"endOffset\":9,\"colorTag\":\"yellow\",\"renderingVersion\":\"$version\"}" -w ' %{http_code}' \
  "$highlights") || fail "the highlight was not made"
case "$made" in *"\"renderingVersion\":\"$version\""*' 201') ;; *) fail "making a highlight answered $made" ;; esac
case "$made" in *'"selectedText":""'*) fail "the highlight holds no text: $made" ;; esac
highlight=$(printf '%s' "$made" | sed -nE 's/.*"id":"([0-9A-F-]+)".*/\1/p')
listed=$(curl -s --max-time 30 "${as_app[@]}" "$highlights") || fail "the document's highlights did not answer"
case "$listed" in *"\"id\":\"$highlight\""*'"isStale":false'*|*'"isStale":false'*"\"id\":\"$highlight\""*) ;;
  *) fail "the document does not list its highlight: $listed" ;; esac
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' -X DELETE "${as_app[@]}" -H "X-CSRF-Token: $token" \
  "$base/api/v1/me/highlights/$highlight" || true)
[ "$code" = 204 ] || fail "deleting the highlight answered $code"
echo "   made over d1's first nine characters at version $version, listed and not stale, and removed"

echo "== collections: no PDF while the pdf profile is off"
# Compose names http://pdf:3000 in FRUS_PDF_URL whether or not the profile runs Gotenberg there: the
# server offers PDF only while it answers (PLAN's S25a).
offered=$(curl -s --max-time 10 "$base/api/v1/pdf") || fail "/api/v1/pdf did not answer"
case "$offered" in *'"available":false'*) ;; *) fail "the server offers PDF with no pdf service: $offered" ;; esac
made=$(curl -s --max-time 5 -X POST "${as_app[@]}" -H "X-CSRF-Token: $token" -H 'Content-Type: application/json' \
  --data '{"name":"Smoke letters"}' "$base/api/v1/me/collections") || fail "the collection was not made"
collection=$(printf '%s' "$made" | sed -nE 's/.*"id":"([0-9A-F-]+)".*/\1/p' | head -1)
[ -n "$collection" ] || fail "making a collection answered $made"
added=$(curl -s --max-time 30 -X POST "${as_app[@]}" -H "X-CSRF-Token: $token" -H 'Content-Type: application/json' \
  --data '{"documents":[{"volumeId":"frus1961-63v06","documentId":"d1"},{"volumeId":"frus1961-63v06","documentId":"d2"}]}' \
  -o /dev/null -w '%{http_code}' "$base/api/v1/me/collections/$collection/documents" || true)
[ "$added" = 200 ] || fail "adding the collection's documents answered $added"
export_as() {  # $1: the format; $2: the file it writes, with its headers beside it. Prints the status and the type.
  curl -s --max-time 330 -X POST "${as_app[@]}" -H "X-CSRF-Token: $token" -H 'Content-Type: application/json' \
    --data "{\"format\":\"$1\",\"timeZone\":\"America/New_York\"}" -D "$2.headers" -o "$2" -w '%{http_code} %{content_type}' \
    "$base/api/v1/me/collections/$collection/export" || true
}
answer=$(export_as pdf "$work/refused.json")
case "$answer $(cat "$work/refused.json")" in '503 application/problem+json'*'"code":"PDF_SERVICE_UNAVAILABLE"'*) ;;
  *) fail "a PDF with no pdf service answered $answer: $(cat "$work/refused.json")" ;; esac
echo "   /api/v1/pdf offers none, and a collection's PDF is refused as PDF_SERVICE_UNAVAILABLE"

echo "== collections: a collection's PDF through the pdf profile's Gotenberg, holding its documents' titles"
python3 scripts/pdf-text selftest >/dev/null || fail "scripts/pdf-text cannot read the PDF its selftest writes"
COMPOSE_PROFILES=pdf docker compose up -d pdf > "$work/pdf-up.log" 2>&1 || fail "the pdf profile did not start: $(tail -5 "$work/pdf-up.log")"
# Kept for the rest of the run, so that the steps after this, the browser suite's PDF and the clean-up
# keep the pdf service in the project.
export COMPOSE_PROFILES=pdf
[ "$(docker inspect --format '{{.HostConfig.ReadonlyRootfs}}' "$(docker compose ps -q pdf)")" = true ] || fail "the pdf service's root filesystem is not read-only"
offered=""
for _ in $(seq 1 120); do  # the server asks the service again ten seconds after its last answer
  offered=$(curl -s --max-time 10 "$base/api/v1/pdf" || true)
  case "$offered" in *'"available":true'*) break ;; esac
  sleep 0.5
done
case "$offered" in *'"available":true'*) ;; *) fail "the server does not offer PDF with the pdf service up: $offered; $(docker compose logs --no-color pdf 2>&1 | tail -5)" ;; esac
# On the pdf network alone, which Compose makes internal: it reaches the server and nothing else.
networks=$(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}} {{end}}' "$(docker compose ps -q pdf)")
[ "$networks" = "${COMPOSE_PROJECT_NAME}_pdf " ] || fail "the pdf service is on the networks $networks"
[ "$(docker network inspect --format '{{.Internal}}' "${COMPOSE_PROJECT_NAME}_pdf")" = true ] || fail "the pdf network is not internal"
# The titles the HTML export gives the collection's documents, each its section's heading, are the
# PDF's to hold: it prints that page.
answer=$(export_as html "$work/collection.html")
[ "$answer" = "200 text/html; charset=utf-8" ] || fail "the collection's HTML answered $answer"
titles=()
while IFS= read -r title; do titles+=(--contains "$title"); done < <(python3 - "$work/collection.html" <<'PY'
import html, re, sys
page = open(sys.argv[1], encoding='utf-8').read()
for heading in re.findall(r'<section id="doc-[^"]*">\s*<h2>(.*?)</h2>', page, re.S):
    print(' '.join(html.unescape(re.sub(r'<[^>]+>', '', heading)).split()))
PY
)
[ "${#titles[@]}" = 4 ] || fail "the HTML export gives ${#titles[@]} titles' arguments, not two documents' titles"
answer=$(export_as pdf "$work/collection.pdf")
[ "$answer" = "200 application/pdf" ] || fail "the collection's PDF answered $answer: $(head -c 300 "$work/collection.pdf")"
grep -qi '^content-disposition: attachment; filename="Smoke letters.pdf"' "$work/collection.pdf.headers" \
  || fail "the PDF is not named as the app names it: $(grep -i '^content-disposition' "$work/collection.pdf.headers")"
[ "$(head -c 5 "$work/collection.pdf")" = "%PDF-" ] || fail "the collection's PDF is no PDF"
python3 scripts/pdf-text "$work/collection.pdf" "${titles[@]}" || fail "the PDF does not hold its documents' titles: $(python3 scripts/pdf-text "$work/collection.pdf" | head -5)"
kept=$(curl -s --max-time 5 "${as_app[@]}" "$base/api/v1/me/history") || fail "the history did not answer"
case "$kept" in *'"format":"pdf"'*'"formatName":"PDF"'*|*'"formatName":"PDF"'*'"format":"pdf"'*) ;; *) fail "the history does not keep the PDF: $kept" ;; esac
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' -X DELETE "${as_app[@]}" -H "X-CSRF-Token: $token" \
  "$base/api/v1/me/collections/$collection" || true)
[ "$code" = 204 ] || fail "deleting the collection answered $code"
echo "   $(wc -c < "$work/collection.pdf" | tr -d ' ') bytes, named Smoke letters.pdf, holding the titles $(printf '%s' "${titles[1]}") and $(printf '%s' "${titles[3]}"), and kept in the history; Gotenberg read-only and on its own network"

echo "== install: behind nginx at the root, with docs/INSTALL.md's recipe"
start_proxy "at the root" /healthz
for path in / "/doc/frus1961-63v06/d1" /api/v1/status "/api/v1/volumes/frus1961-63v06/documents/d1/html" /reader/host.js \
    /reader/frus-highlights.js /readyz; do
  code=$(through_proxy "$path")
  [ "$code" = 200 ] || fail "$path answered $code through nginx"
done
echo "   the app, a client route, the API, the reader's page and its scripts, and /readyz"

if [ -n "$e2e" ]; then
  echo "== all areas: the browser suite at the root, Playwright on Chromium"
  # In the server's network namespace, so the app is http://localhost:8080, a secure context.
  FRUS_E2E_NETWORK="container:$container" FRUS_E2E_BASE_URL=http://localhost:8080/ scripts/npm --playwright \
    || fail "the browser suite failed; web/playwright-report has its report"
fi

# Waits up to a minute for the container's health check to pass.
wait_healthy() {
  local health=""
  for _ in $(seq 1 60); do
    health=$(docker inspect --format '{{.State.Health.Status}}' "$container")
    [ "$health" = healthy ] && return 0
    sleep 1
  done
  fail "the container's health is $health"
}

echo "== install: health check"
wait_healthy
echo "   healthy"

echo "== install: a restart, the index staying in the volume"
docker compose restart frus >/dev/null
wait_for_200 "$base/readyz" 60 || fail "/readyz did not reach 200 after a restart"

echo "== install: under a path, FRUS_PUBLIC_URL ending in /frus-explorer/"
# The container is made again with the path, and the index stays in the volume. /healthz and
# /readyz answer at the root as well, so Docker's health check is unchanged.
FRUS_PUBLIC_URL=http://localhost:8080/frus-explorer/ docker compose up -d frus 2>/dev/null
container=$(docker compose ps -q frus)
under="$base/frus-explorer"
wait_for_200 "$base/readyz" 60 || fail "/readyz did not reach 200 at the root under a path"
wait_for_200 "$under/readyz" 5 || fail "/frus-explorer/readyz did not answer 200"
app=$(curl -s --max-time 5 -o "$work/under.html" -w '%{http_code} %{content_type}' "$under/" || true)
[ "$app" = "200 text/html; charset=utf-8" ] || fail "/frus-explorer/ answered $app"
grep -q '<base href="/frus-explorer/" />' "$work/under.html" || fail "/frus-explorer/ does not write its path into <base>"
curl -s --max-time 5 -o "$work/route.html" "$under/doc/frus1961-63v06/d1" || fail "a client route did not answer"
cmp -s "$work/under.html" "$work/route.html" || fail "a client route under the path is not the app's page"
script=$(sed -nE 's/.*<script type="module"[^>]* src="([^"]+)".*/\1/p' "$work/under.html" | head -1)
curl -s --max-time 5 -D "$work/script.headers" -o /dev/null "$under/${script#./}" || fail "$script did not answer"
grep -qi '^cache-control: public, max-age=31536000, immutable' "$work/script.headers" || fail "$script under the path is not the app's"
status=$(curl -s --max-time 5 "$under/api/v1/status") || fail "/frus-explorer/api/v1/status did not answer"
printf '%s' "$status" | grep -q '"documents":7' || fail "status under the path does not report 7 documents: $status"
curl -s --max-time 30 -o "$work/page.html" "$under/api/v1/volumes/frus1961-63v06/documents/d1/html" || fail "the reader's page did not answer"
for file in frus-offset-engine.js frus-highlights.js frus-selection.js host.js; do
  grep -q "<script src=\"/frus-explorer/reader/$file\" defer></script>" "$work/page.html" || fail "the page does not name /reader/$file under the path"
done
for path in /frus-explorer/healthz /frus-explorer/reader/host.js /frus-explorer/reader/frus-selection.js; do
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base$path" || true)
  [ "$code" = 200 ] || fail "$path answered $code"
done
redirect=$(curl -s --max-time 5 -o /dev/null -w '%{http_code} %{redirect_url}' "$base/frus-explorer" || true)
[ "$redirect" = "308 $base/frus-explorer/" ] || fail "/frus-explorer answered $redirect"
for path in /search /api/v1/status "/${script#./}"; do
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base$path" || true)
  [ "$code" = 404 ] || fail "$path, outside the path, answered $code"
done
echo "   the page with its base, a client route, $script, the API, the reader's page and its scripts under the path; health at both; 404 outside it"

echo "== install: behind nginx under the path, with docs/INSTALL.md's recipe"
start_proxy "under a path" /frus-explorer/healthz
for path in /frus-explorer /frus-explorer/ "/frus-explorer/search?keywords=treaties" /frus-explorer/api/v1/status /frus-explorer/reader/host.js \
    /frus-explorer/reader/frus-offset-engine.js /frus-explorer/readyz; do
  code=$(through_proxy "$path")
  [ "$code" = 200 ] || fail "$path answered $code through nginx"
done
echo "   the app, its own path without the slash, a client route, the API, the host script and /readyz"

if [ -n "$e2e" ]; then
  echo "== all areas: the browser suite under the path, through nginx, Playwright on Chromium"
  # In the proxy's network namespace, so the app is http://localhost:8080/frus-explorer/.
  FRUS_E2E_NETWORK="container:$proxy" FRUS_E2E_BASE_URL=http://localhost:8080/frus-explorer/ scripts/npm --playwright \
    || fail "the browser suite failed under the path; web/playwright-report has its report"
fi

echo "== settings: an import of more than 4 MiB through nginx under the path, with the recipe's limit"
# The browser suite's export, padded with spaces past 4 MiB, sent through the guard from inside the
# proxy's container as the browser app sends it, and followed to its report. After the browser
# suite, which expects a store without the export's notes.
{ cat fixtures/import/research-export.json; head -c 5242880 /dev/zero | tr '\0' ' '; } > "$work/import.json"
docker cp "$work/import.json" "$proxy:/tmp/import.json" >/dev/null || fail "the export could not be copied to nginx"
me=$(docker exec "$proxy" wget -q -O - "http://localhost:8080/frus-explorer/api/v1/me") || fail "/api/v1/me did not answer through nginx"
token=$(printf '%s' "$me" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p')
posted=$(docker exec "$proxy" wget -q -S -O - --header 'Content-Type: application/json' --header "X-CSRF-Token: $token" \
  --header 'Origin: http://localhost:8080' --post-file /tmp/import.json "http://localhost:8080/frus-explorer/api/v1/me/import" 2>&1 || true)
case "$posted" in *'HTTP/1.1 202'*) ;; *) fail "the import through nginx answered: $(printf '%s' "$posted" | head -3)" ;; esac
job=$(printf '%s' "$posted" | sed -nE 's/.*"id":"([0-9A-F-]+)".*/\1/p' | head -1)
[ -n "$job" ] || fail "the import through nginx gave no id: $(printf '%s' "$posted" | tail -1)"
state=""
for _ in $(seq 1 120); do
  state=$(docker exec "$proxy" wget -q -O - "http://localhost:8080/frus-explorer/api/v1/me/import/$job" 2>/dev/null \
    | sed -nE 's/.*"state":"([a-z]+)".*/\1/p' || true)
  [ "$state" = succeeded ] && break
  [ "$state" = failed ] && break
  sleep 0.25
done
[ "$state" = succeeded ] || fail "the import through nginx ended $state"
echo "   $(wc -c < "$work/import.json" | tr -d ' ') bytes, accepted and imported"

echo "== settings: stored keys, sealed under the key file the server made, and a start without it refused"
# PLAN's S20c: the user's NARA key and the instance's, set through the write guard and named as set,
# never given back; the key file the first start made, the server's user's alone; no key as it was
# given in the volume, the log or the backup's archive, whose manifest lists the table and holds no key
# file; a start whose key file is gone refused with the install guide's sentence, none made in its
# place, and a start with it back. The instance's key stays, for the backup and restore after this.
keys="$under/api/v1/me/secrets"
me=$(curl -s --max-time 5 "${as_app[@]}" "$under/api/v1/me") || fail "/api/v1/me did not answer under the path"
token=$(printf '%s' "$me" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p')
[ -n "$token" ] || fail "/api/v1/me gave no token: $me"
secret="smoke-key-$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')"
key_states() {  # $1: GET /api/v1/me/secrets's answer. Prints each key's name and whether it is set, then the instance's.
  python3 -c 'import json, sys
d = json.loads(sys.argv[1])
print(" ".join("%s=%s" % (s["name"], "set" if s["set"] else "unset") for s in d["secrets"]), "instance=" + ",".join(d.get("instance") or []))' "$1"
}
put_key() {  # $1: the route; $2: the key; the rest: curl's arguments. Prints the answer and its status.
  local route=$1 value=$2
  shift 2
  curl -s --max-time 5 -X PUT -H 'Content-Type: application/json' --data "{\"value\":\"$value\"}" "$@" -w ' %{http_code}' "$route" || true
}
listed=$(curl -s --max-time 5 "${as_app[@]}" "$keys") || fail "/api/v1/me/secrets did not answer"
[ "$(key_states "$listed")" = "nara=unset zotero=unset instance=" ] || fail "a new store lists keys: $listed"
case "$(put_key "$keys/nara" "$secret" "${as_app[@]}")" in *'"code":"CSRF_TOKEN_INVALID"'*' 403') ;; *) fail "a key was taken without the token" ;; esac
case "$(put_key "$keys/nara" "$secret" -H "Host: localhost:8080" -H "Origin: https://attacker.example" -H "X-CSRF-Token: $token")" in
  *'"code":"ORIGIN_NOT_ALLOWED"'*' 403') ;; *) fail "a key was taken from another origin" ;; esac
user_put=$(put_key "$keys/nara" "$secret" "${as_app[@]}" -H "X-CSRF-Token: $token")
case "$user_put" in *'"set":true'*' 200') ;; *) fail "setting the key answered $user_put" ;; esac
instance_put=$(put_key "$under/api/v1/admin/secrets/nara" "$secret-instance" "${as_app[@]}" -H "X-CSRF-Token: $token")
case "$instance_put" in *'"set":true'*' 200') ;; *) fail "setting the instance's key answered $instance_put" ;; esac
listed=$(curl -s --max-time 5 "${as_app[@]}" "$keys") || fail "/api/v1/me/secrets did not answer"
[ "$(key_states "$listed")" = "nara=set zotero=unset instance=nara" ] || fail "the keys set are listed as $listed"
shared=$(curl -s --max-time 5 "${as_app[@]}" "$under/api/v1/admin/secrets") || fail "/api/v1/admin/secrets did not answer"
[ "$(key_states "$shared")" = "nara=set instance=" ] || fail "the instance's keys are listed as $shared"
case "$user_put $instance_put $listed $shared" in *"$secret"*) fail "an answer gave a key back" ;; esac
facts=$(docker exec "$container" stat -c '%a %u %s' /data/app/secret.key) || fail "the server made no key file"
[ "$facts" = "600 10001 32" ] || fail "the key file is mode, owner and size $facts, not 600 10001 32"
# grep's 1 is no match; 0 a match, and anything else a search that could not be made.
found=0
docker exec "$container" grep -rqF "$secret" /data/app /data/backups || found=$?
[ "$found" = 1 ] || fail "the store or its backups hold a key as it was given, or could not be searched (grep's status $found)"
case "$(docker compose logs --no-color frus 2>&1)" in *"$secret"*) fail "the server's log holds a key" ;; esac
docker compose exec -T frus frus-light backup >/dev/null || fail "frus-light backup failed"
answer=$(curl -s --max-time 30 -H "Host: localhost:8080" -o "$work/keys.tar" -w '%{http_code}' "$under/api/v1/admin/backup" || true)
[ "$answer" = 200 ] || fail "GET /api/v1/admin/backup answered $answer"
docker exec "$container" cat /data/app/secret.key > "$work/secret.key" || fail "the key file could not be read"
python3 - "$work/keys.tar" "$work/secret.key" "$secret" <<'PY' || fail "the backup's archive does not carry the keys as it should"
import json, sys, tarfile
archive, key, secret = open(sys.argv[1], 'rb').read(), open(sys.argv[2], 'rb').read(), sys.argv[3].encode()
with tarfile.open(sys.argv[1]) as tar:
    names = tar.getnames()
    manifest = json.load(tar.extractfile('manifest.json'))
assert names[0] == 'manifest.json' and len(names) == 2 and names[1].startswith('app-'), names
carried = manifest['secrets']
assert carried['table'] == 'secrets' and carried['rows'] == 2 and len(carried['keyIds']) == 1, carried
assert carried['keyFileIncluded'] is False, carried
assert key not in archive, 'the archive holds the key file'
assert secret not in archive, 'the archive holds a key as it was given'
PY
docker exec "$container" mv /data/app/secret.key /data/app/secret.key.kept || fail "the key file could not be moved"
# A second server over the same volume, in a container of its own, which must stop at once: it is given a
# minute, since one that started would never stop, and is removed either way.
keyless="$COMPOSE_PROJECT_NAME-keyless"
docker compose run -d --no-deps --name "$keyless" frus >/dev/null 2>&1 || fail "a server without its key file could not be run"
state=""
for _ in $(seq 1 120); do
  state=$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$keyless" 2>/dev/null || true)
  case "$state" in exited*) break ;; esac
  sleep 0.5
done
docker logs "$keyless" > "$work/keyless.txt" 2>&1 || true
docker rm -f "$keyless" >/dev/null 2>&1 || true
case "$state" in exited\ 0|exited) fail "a server without its key file exited with $state" ;; exited*) ;;
  *) fail "a server without its key file did not stop: $state; $(tail -3 "$work/keyless.txt")" ;; esac
grep -qF "frus-light: the user store holds 2 stored keys, and the key file that opens them, /data/app/secret.key, is missing." "$work/keyless.txt" \
  || fail "a start without its key file said: $(tail -3 "$work/keyless.txt")"
if docker exec "$container" test -e /data/app/secret.key; then fail "a start without its key file made one"; fi
docker exec "$container" mv /data/app/secret.key.kept /data/app/secret.key || fail "the key file could not be put back"
docker compose restart frus >/dev/null 2>&1 || fail "the server could not be restarted"
wait_for_200 "$base/readyz" 60 || fail "/readyz did not reach 200 with the key file back"
# A new process, with a new token.
me=$(curl -s --max-time 5 "${as_app[@]}" "$under/api/v1/me" || true)
token=$(printf '%s' "$me" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p')
[ -n "$token" ] || fail "/api/v1/me gave no token after the restart: $me"
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' -X DELETE "${as_app[@]}" -H "X-CSRF-Token: $token" "$keys/nara" || true)
[ "$code" = 204 ] || fail "clearing the key answered $code"
listed=$(curl -s --max-time 5 "${as_app[@]}" "$keys") || fail "/api/v1/me/secrets did not answer"
[ "$(key_states "$listed")" = "nara=unset zotero=unset instance=nara" ] || fail "the key cleared is listed as $listed"
echo "   set and named as set, never given back; the key file 0600, the server's alone; the archive's manifest lists the table, with no key file; a start without it refused, and one with it back"

echo "== admin: an export made with the owner's writing (PLAN's S16e)"
# The server keeps the writing in the user's store, strips its copy with the kit's statements, with
# SQLite's temporary files in the volume rather than the tmpfs, and installs it; check 5's script then
# searches the installed index for the writing. After the browser suite, which expects none of it.
# The whole log first: grep -q would stop reading it at its match, and under pipefail the writer's
# broken pipe would fail the check.
server_log=$(docker compose logs --no-color frus 2>&1)
case "$server_log" in *"SQLite's temporary files go to /data/tmp"*) ;; *) fail "the server does not put SQLite's temporary files in /data/tmp" ;; esac
scripts/synthetic-export --own-text --writing "$work/writing.sqlite" >/dev/null
docker compose cp "$work/writing.sqlite" frus:/data/import/writing.sqlite
# The index already served stays served meanwhile, so the status's report of the import, which only an
# installed export with writing gives, says when it is done.
installed=""
for _ in $(seq 1 240); do
  status=$(curl -s --max-time 5 "$under/api/v1/status" || true)
  case "$status" in *"were moved into your research data"*) installed=1; break ;; esac
  sleep 0.25
done
[ -n "$installed" ] || fail "the export with writing was not installed: $status"
case "$status" in *"marked as from a research database"*) ;; *) fail "the report does not say the writing is marked: $status" ;; esac
case "$status" in *"Export as JSON"*) ;; *) fail "the report does not recommend the JSON export: $status" ;; esac
docker compose cp frus:/data/index/frus.db "$work/installed.sqlite"
scripts/check-stripped-export "$work/installed.sqlite" "$work/writing.sqlite" | sed 's/^/   /'
notes=$(curl -s --max-time 5 "${as_app[@]}" "$under/api/v1/me/notes") || fail "the notes did not answer"
case "$notes" in *'Ask the archivist whether the Vienna cables survive'*'"fromResearchDatabase":true'*|*'"fromResearchDatabase":true'*'Ask the archivist whether the Vienna cables survive'*) ;;
  *) fail "the store does not hold the export's note block, marked: $notes" ;; esac
summaries=$(curl -s --max-time 5 "${as_app[@]}" "$under/api/v1/me/volumes/frus1961-63v06/documents/d1/summaries") || fail "the summaries did not answer"
case "$summaries" in *'Llewellyn Thompson reports from Moscow'*) ;; *) fail "the store does not hold the export's summary: $summaries" ;; esac
echo "   installed, its writing in the store and marked, none of it in the index"

echo "== admin: VACUUM's copy in the volume, past a /tmp of 64 KB"
# An export with writing whose copy outgrows SQLite's page cache, so VACUUM writes it to disk: the image
# installs it in a container whose /tmp holds 64 KB, and fails to with SQLITE_TMPDIR=/tmp forced.
scripts/synthetic-export --writing "$work/large.sqlite" >/dev/null
sqlite3 "$work/large.sqlite" "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 20000)
  INSERT INTO document_cache (volume_id, document_id, header, body_text)
    SELECT 'frus1961-63v06', 'n' || i, 'Header ' || i, 'The body of document ' || i || ', ' || printf('%.400c', 'x') FROM n;
  UPDATE document_cache SET note_text = 'A note on document ' || rowid WHERE document_id GLOB 'n[0-9]*' AND rowid % 4 = 0;" >/dev/null
for folder in volume tmp; do
  side="$COMPOSE_PROJECT_NAME-tmp-$folder"
  forced=()
  [ "$folder" = tmp ] && forced=(-e SQLITE_TMPDIR=/tmp)
  docker volume create "$side" >/dev/null
  docker run -d --name "$side" --read-only --tmpfs /tmp:size=64k -v "$side:/data" -e FRUS_MODE=import -e FRUS_AUTH=none \
    -e FRUS_IMPORT_POLL_SECONDS=0.2 ${forced[@]+"${forced[@]}"} "$FRUS_IMAGE" >/dev/null || fail "the image did not start with a small /tmp"
  # The server makes the drop zone in its new volume as it starts.
  for _ in $(seq 1 120); do
    docker exec "$side" test -d /data/import 2>/dev/null && break
    sleep 0.25
  done
  docker cp "$work/large.sqlite" "$side:/data/import/large.sqlite" >/dev/null || fail "the export could not be copied into the drop zone"
  outcome=""
  for _ in $(seq 1 240); do
    side_log=$(docker logs "$side" 2>&1)
    case "$side_log" in
      *"Installed "*) outcome=installed; break ;;
      *"Import of large.sqlite failed"*) outcome=failed; break ;;
      *"Import of large.sqlite refused"*) outcome=refused; break ;;
    esac
    sleep 0.25
  done
  docker rm -f "$side" >/dev/null
  docker volume rm "$side" >/dev/null
  case "$folder:$outcome" in
    volume:installed|tmp:failed) ;;
    *) fail "with SQLite's temporary files in /$folder, the import ended ${outcome:-in no time given}: $(printf '%s' "$side_log" | tail -3)" ;;
  esac
done
echo "   $(wc -c < "$work/large.sqlite" | tr -d ' ') bytes: installed with them in /data/tmp, and not with them in /tmp"

echo "== admin: a backup, through the API, and its restore"
# What the import and the browser suite wrote, as the export gives every record of the user's,
# without the time it was made: the research to read back after the restore.
research() {
  curl -s --max-time 30 -H "Host: localhost:8080" "$under/api/v1/me/export?includeGeneratedSummaries=true" | grep -v '"exportedAt"'
}
research > "$work/before.json"
grep -q '"notes" : \[$' "$work/before.json" || fail "the export holds no notes: $(head -c 300 "$work/before.json")"
# The server's own look may have taken one of the store as it stands, while the browser suite ran.
taken=$(docker compose exec -T frus frus-light backup) || fail "frus-light backup failed: $taken"
backup=$(printf '%s\n' "$taken" | sed -nE -e 's|^Backed up app\.db to /data/backups/(app-[0-9TZ-]+\.db)\.$|\1|p' \
  -e 's|^app\.db has not changed since (app-[0-9TZ-]+\.db), the newest backup.*|\1|p')
[ -n "$backup" ] || fail "frus-light backup took none: $taken"
[ -f "$work/backups/$backup" ] || fail "$backup was not copied to the host folder"
again=$(docker compose exec -T frus frus-light backup) || fail "frus-light backup failed again: $again"
case "$again" in *"has not changed since $backup"*) ;; *) fail "a second backup of the same store answered: $again" ;; esac
# The API gives the newest with its manifest, as a tar archive: the copy in the host folder, byte
# for byte, which the manifest's SHA-256 names.
answer=$(curl -s --max-time 30 -H "Host: localhost:8080" -o "$work/backup.tar" -w '%{http_code} %{content_type}' \
  "$under/api/v1/admin/backup" || true)
[ "$answer" = "200 application/x-tar" ] || fail "GET /api/v1/admin/backup answered $answer"
mkdir "$work/archive"
tar -xf "$work/backup.tar" -C "$work/archive" || fail "the API's archive is not a tar file tar reads"
cmp -s "$work/archive/$backup" "$work/backups/$backup" || fail "the API's backup is not $backup"
sum=$(shasum -a 256 "$work/archive/$backup" | cut -d' ' -f1)
grep -q "\"sha256\" : \"$sum\"" "$work/archive/manifest.json" || fail "the manifest does not name $backup's SHA-256: $(cat "$work/archive/manifest.json")"
# A restore waits for the server to stop: the store is the server's while it runs.
if docker compose run --rm --no-deps frus restore "$backup" > /dev/null 2> "$work/refused.txt"; then
  fail "a restore ran while the server was running"
fi
grep -q "stop it first" "$work/refused.txt" || fail "a restore beside the server said: $(cat "$work/refused.txt")"
docker compose stop frus > /dev/null 2>&1
docker compose run --rm --no-deps --entrypoint rm frus -f /data/app/app.db /data/app/app.db-wal /data/app/app.db-shm \
  > /dev/null 2>&1 || fail "the store could not be removed"
restored=$(docker compose run --rm --no-deps frus restore "$backup" 2> "$work/restore.txt") \
  || fail "the restore failed: $(cat "$work/restore.txt")"
case "$restored" in *"Restored /data/backups/$backup, at migration "*) ;; *) fail "the restore said: $restored" ;; esac
docker compose start frus > /dev/null 2>&1
wait_for_200 "$base/readyz" 60 || fail "/readyz did not reach 200 after the restore"
research > "$work/after.json"
cmp -s "$work/before.json" "$work/after.json" \
  || fail "the restored store's research differs: $(diff "$work/before.json" "$work/after.json" | head -20)"
echo "   $backup, also in the host folder and through the API with its SHA-256; refused beside the server; the store removed, restored and its research read back whole"

echo "== install: health check under the path"
wait_healthy
echo "   healthy"

echo "== install: signing in with accounts of the server's own, FRUS_AUTH=local"
# The server is made again with local accounts (S20b), under the path, and makes two with frus-light
# user, each password a line of standard input, random for this run: erin, an admin, and frank, a
# reader; the proxy's sign-in, after this, names alice, bob, carol and dave, none of them. curl reaches
# the server through the published port, from the Compose network's gateway, and carries the session's
# cookie itself: curl keeps no Secure cookie from an address that is not https.
password=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
FRUS_PUBLIC_URL=http://localhost:8080/frus-explorer/ FRUS_AUTH=local docker compose up -d frus 2>/dev/null
wait_for_200 "$base/readyz" 60 || fail "/readyz did not reach 200 with local accounts"
made=$(printf '%s\n' "$password" | docker compose exec -T frus frus-light user add erin --role admin) \
  || fail "frus-light user add erin failed: $made"
[ "$made" = "Made erin, an admin. They sign in at http://localhost:8080/frus-explorer/." ] || fail "user add said: $made"
printf '%s\n' "$password" | docker compose exec -T frus frus-light user add frank >/dev/null || fail "frus-light user add frank failed"
if printf 'short\n' | docker compose exec -T frus frus-light user add grace 2>/dev/null; then fail "a short password was taken"; fi
auth() {  # $1: sign-in or sign-out; $2: the body, or nothing; the rest: curl's arguments
  local what=$1 body=$2
  shift 2
  curl -s --max-time 30 -D "$work/auth.headers" -H "Host: localhost:8080" -H 'Origin: http://localhost:8080' \
    -H 'Content-Type: application/json' ${body:+--data "$body"} -X POST -w ' %{http_code}' "$@" "$under/api/v1/auth/$what" || true
}
cookie_of() { sed -nE 's/^[Ss]et-[Cc]ookie: (frus_session=[0-9a-f]{64});.*/\1/p' "$work/auth.headers" | tr -d '\r'; }
as_session() {  # $1: the cookie; the rest: curl's arguments
  local cookie=$1
  shift
  curl -s --max-time 30 -H "Host: localhost:8080" -H "Cookie: $cookie" "$@" || true
}
session=$(curl -s --max-time 5 -H "Host: localhost:8080" "$under/api/v1/auth/session" || true)
# The order of a body's keys can change from one answer to the next, but for a problem's, which are
# sorted: a check reads a body's fields, and compares two bodies whole only when both are problems.
case "$session" in *'"auth":"local"'*) ;; *) fail "the session with no cookie does not name local accounts: $session" ;; esac
case "$session" in *'"signedIn":false'*) ;; *) fail "the session with no cookie is signed in: $session" ;; esac
refused=$(curl -s --max-time 5 -H "Host: localhost:8080" -w ' %{http_code}' "$under/api/v1/me" || true)
case "$refused" in *'"code":"NOT_SIGNED_IN"'*' 403') ;; *) fail "/api/v1/me with no session answered $refused" ;; esac
wrong=$(auth sign-in '{"name":"erin","password":"not her password at all"}')
case "$wrong" in *'"code":"SIGN_IN_FAILED"'*' 403') ;; *) fail "a wrong password answered $wrong" ;; esac
nobody=$(auth sign-in "{\"name\":\"nobody\",\"password\":\"$password\"}")
[ "$nobody" = "$wrong" ] || fail "a name with no account answered otherwise than a wrong password: $nobody"
signed=$(auth sign-in "{\"name\":\"erin\",\"password\":\"$password\"}")
case "$signed" in *' 200') ;; *) fail "erin's sign-in answered $signed" ;; esac
case "$signed" in *'"userId":"erin"'*) ;; *) fail "erin's sign-in named another: $signed" ;; esac
case "$signed" in *'"auth":"local"'*) ;; *) fail "the server does not sign in with its own accounts: $signed" ;; esac
grep -qiE '^set-cookie: frus_session=[0-9a-f]{64}; Path=/frus-explorer/; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax' "$work/auth.headers" \
  || fail "the session's cookie is not as it should be: $(grep -i '^set-cookie' "$work/auth.headers")"
erin=$(cookie_of)
me=$(as_session "$erin" "$under/api/v1/me")
case "$me" in *'"userId":"erin"'*) ;; *) fail "erin's cookie names $me" ;; esac
case "$me" in *'"admin"'*) ;; *) fail "erin, made an admin, is none: $me" ;; esac
token=$(printf '%s' "$me" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p')
made=$(as_session "$erin" -H 'Content-Type: application/json' -H "X-CSRF-Token: $token" -H 'Origin: http://localhost:8080' \
  --data '{"name":"Local"}' "$under/api/v1/me/tags")
case "$made" in *'"name":"Local"'*) ;; *) fail "erin's tag was not made: $made" ;; esac
auth sign-in "{\"name\":\"frank\",\"password\":\"$password\"}" >/dev/null
frank=$(cookie_of)
[ -n "$frank" ] && [ "$frank" != "$erin" ] || fail "frank's sign-in gave no session of his own"
tags=$(as_session "$frank" "$under/api/v1/me/tags")
case "$tags" in *'"total":0'[,}]*) ;; *) fail "frank's tags hold erin's: $tags" ;; esac
tags=$(as_session "$erin" "$under/api/v1/me/tags")
case "$tags" in *'"total":1'[,}]*) ;; *) fail "erin's tags are not the one she made: $tags" ;; esac
# What the reader's sandboxed frame asks for carries no cookie, and needs none.
code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' -H "Host: localhost:8080" "$under/reader/frus-selection.js" || true)
[ "$code" = 200 ] || fail "the reader's selection script with no session answered $code"
absent=$(curl -s --max-time 5 -H "Host: localhost:8080" "$under/api/v1/volumes/frus1961-63v06/figures/none.png" || true)
case "$absent" in *'"code":"FIGURE_NOT_FOUND"'*) ;; *) fail "a figure with no session answered $absent" ;; esac
docker compose exec -T frus frus-light user disable frank >/dev/null || fail "frus-light user disable failed"
disabled=$(auth sign-in "{\"name\":\"frank\",\"password\":\"$password\"}")
[ "$disabled" = "$wrong" ] || fail "a disabled account's sign-in answered otherwise than a wrong password: $disabled"
docker compose exec -T frus frus-light user enable frank >/dev/null || fail "frus-light user enable failed"
out=$(auth sign-out '' -H "Cookie: $erin")
[ "$out" = " 204" ] || fail "erin's sign-out answered $out"
grep -qi '^set-cookie: frus_session=; Path=/frus-explorer/; Max-Age=0' "$work/auth.headers" || fail "the sign-out did not clear the cookie"
gone=$(as_session "$erin" -w ' %{http_code}' "$under/api/v1/me")
case "$gone" in *'"code":"NOT_SIGNED_IN"'*' 403') ;; *) fail "erin's ended session answered $gone" ;; esac
listed=$(docker compose exec -T frus frus-light user list) || fail "frus-light user list failed"
case "$listed" in *"erin "*"admin "*"can sign in, last signed in "*) ;; *) fail "frus-light user list said: $listed" ;; esac
# Last, as it slows this address for everyone behind it: five more failures for a name it has not
# tried, and the sixth attempt waits.
for attempt in 1 2 3 4 5; do auth sign-in "{\"name\":\"slowed\",\"password\":\"guess $attempt\"}" >/dev/null; done
slowed=$(auth sign-in "{\"name\":\"slowed\",\"password\":\"guess 6\"}")
case "$slowed" in *'"code":"SIGN_IN_SLOWED"'*' 429') ;; *) fail "the sixth attempt answered $slowed" ;; esac
grep -qiE '^retry-after: [0-9]+' "$work/auth.headers" || fail "the slowed attempt gave no Retry-After"
echo "   erin and frank made with frus-light user, from standard input; no session is no user; a wrong password and an unknown name refused alike; erin's cookie HttpOnly, Secure and SameSite=Lax under the path; her tag not frank's; the frame's scripts and figures need no session; a disabled account refused; a sign-out ends the session; the sixth attempt slowed"

if [ -n "$e2e" ]; then
  echo "== install: signing in with accounts, the accounts spec in Playwright on Chromium"
  # In the server's network namespace, under the path, as erin and frank, by keyboard.
  FRUS_E2E_ACCOUNTS=1 FRUS_E2E_PASSWORD="$password" FRUS_E2E_NETWORK="container:$(docker compose ps -q frus)" \
    FRUS_E2E_BASE_URL=http://localhost:8080/frus-explorer/ scripts/npm --playwright \
    || fail "the accounts spec failed; web/playwright-report has its report"
fi

echo "== admin: the users, a reader refused, the jobs, and a user's research erased, with local accounts (PLAN's S20d)"
# erin, the admin, and frank, a reader, sign in again, waiting out the slowing the step before left on
# this address. frank is refused every route under /api/v1/admin, reads and changes alike; erin lists
# the accounts, gives frank a role his session has at once, and cannot demote herself, the last admin
# who can sign in; the import's job is listed still, finished, after the restarts since; and erin
# erases frank's research once she has counted it, after which his export is empty and hers is not.
sign_in_again() {  # $1: the name. Signs in with the run's password, waiting out a slowing; prints the cookie.
  local answer wait
  for _ in 1 2 3 4 5 6; do
    answer=$(auth sign-in "{\"name\":\"$1\",\"password\":\"$password\"}")
    case "$answer" in
      *' 200') cookie_of; return 0 ;;
      *'"code":"SIGN_IN_SLOWED"'*' 429')
        wait=$(sed -nE 's/^[Rr]etry-[Aa]fter: ([0-9]+).*/\1/p' "$work/auth.headers" | tr -d '\r')
        sleep "$((${wait:-1} + 1))" ;;
      *) fail "$1's sign-in answered $answer" ;;
    esac
  done
  fail "$1's sign-in was slowed six times"
}
token_of() { as_session "$1" "$under/api/v1/me" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p'; }
as_change() {  # $1: the cookie; $2: its token; the rest: curl's arguments
  local cookie=$1 csrf=$2
  shift 2
  as_session "$cookie" -H 'Origin: http://localhost:8080' -H 'Content-Type: application/json' -H "X-CSRF-Token: $csrf" "$@"
}
erin=$(sign_in_again erin)
frank=$(sign_in_again frank)
erin_token=$(token_of "$erin")
frank_token=$(token_of "$frank")
[ -n "$erin_token" ] && [ -n "$frank_token" ] || fail "erin and frank are not both signed in again"
for route in status jobs "jobs/$import_job" users users/erin/research backups backup secrets; do
  answer=$(as_session "$frank" -w ' %{http_code}' "$under/api/v1/admin/$route")
  case "$answer" in *'"code":"ROLE_REQUIRED"'*' 403') ;; *) fail "frank, a reader, was answered for /api/v1/admin/$route: $answer" ;; esac
done
for change in "POST jobs/$import_job/cancel" "POST index/reset" "POST users" "PATCH users/frank" "PUT users/frank/password" \
    "POST users/erin/research/erase" "PUT secrets/nara" "DELETE secrets/nara"; do
  answer=$(as_change "$frank" "$frank_token" -X "${change%% *}" --data '{"role":"admin","expected":{}}' -w ' %{http_code}' \
    "$under/api/v1/admin/${change#* }")
  case "$answer" in *'"code":"ROLE_REQUIRED"'*' 403') ;; *) fail "frank, a reader, was answered for $change: $answer" ;; esac
done
users=$(as_session "$erin" "$under/api/v1/admin/users")
python3 -c 'import json, sys
d = json.loads(sys.argv[1])
roles = {u["id"]: u["role"] for u in d["users"]}
signed = {u["id"] for u in d["users"] if u.get("lastSignInAt")}
sys.exit(0 if d["auth"] == "local" and roles.get("erin") == "admin" and roles.get("frank") == "reader" and {"erin", "frank"} <= signed else 1)' "$users" \
  || fail "the users list is not erin, an admin, and frank, a reader, each signed in: $users"
changed=$(as_change "$erin" "$erin_token" -X PATCH --data '{"role":"curator"}' -w ' %{http_code}' "$under/api/v1/admin/users/frank")
case "$changed" in *'"role":"curator"'*' 200') ;; *) fail "erin could not make frank a curator: $changed" ;; esac
case "$(as_session "$frank" "$under/api/v1/me")" in *'"curator"'*) ;; *) fail "frank's session does not have his new role" ;; esac
changed=$(as_change "$erin" "$erin_token" -X PATCH --data '{"role":"reader"}' -w ' %{http_code}' "$under/api/v1/admin/users/frank")
case "$changed" in *'"role":"reader"'*' 200') ;; *) fail "erin could not make frank a reader again: $changed" ;; esac
last=$(as_change "$erin" "$erin_token" -X PATCH --data '{"role":"reader"}' -w ' %{http_code}' "$under/api/v1/admin/users/erin")
case "$last" in *'"code":"LAST_ADMIN"'*' 409') ;; *) fail "erin, the last admin who can sign in, could demote herself: $last" ;; esac
jobs=$(as_session "$erin" "$under/api/v1/admin/jobs")
python3 -c 'import json, sys
sys.exit(0 if any(j["id"] == sys.argv[2] and j["state"] == "succeeded" for j in json.loads(sys.argv[1])["jobs"]) else 1)' "$jobs" "$import_job" \
  || fail "the import's job, $import_job, is not listed finished after the restarts: $jobs"
made=$(as_change "$frank" "$frank_token" --data '{"name":"Frank"}' "$under/api/v1/me/tags")
case "$made" in *'"name":"Frank"'*) ;; *) fail "frank's tag was not made: $made" ;; esac
# What erin holds of her own, which her export's count cannot say: as an admin, a curator, her export
# also counts the instance's corrections, which are everyone's.
total_of() { as_session "$erin" "$under/api/v1/admin/users/$1/research" | python3 -c 'import json, sys; print(json.load(sys.stdin)["total"])'; }
erin_held=$(total_of erin) || fail "erin's research was not counted"
[ "$erin_held" -ge 1 ] || fail "erin holds no research of her own before frank's erasure: $erin_held"
counted=$(as_session "$erin" "$under/api/v1/admin/users/frank/research")
expected=$(python3 -c 'import json, sys
d = json.loads(sys.argv[1])
assert d["userId"] == "frank" and d["total"] >= 1
print(json.dumps({"expected": {h["table"]: h["count"] for h in d["holdings"]}}))' "$counted") || fail "frank's research was not counted: $counted"
erased=$(as_change "$erin" "$erin_token" --data "$expected" -w ' %{http_code}' "$under/api/v1/admin/users/frank/research/erase")
case "$erased" in *'"userId":"frank"'*' 200') ;; *) fail "erin could not erase frank's research: $erased" ;; esac
held() { as_session "$1" "$under/api/v1/me/export/contents" | python3 -c 'import json, sys; print(sum(t["count"] for t in json.load(sys.stdin)["types"]))'; }
[ "$(held "$frank")" = 0 ] || fail "frank's export is not empty after the erasure"
[ "$(held "$erin")" -ge 1 ] || fail "erin's export is empty after frank's erasure"
[ "$(total_of erin)" = "$erin_held" ] || fail "erin's own research changed with frank's erasure: $erin_held before, $(total_of erin) after"
[ "$(total_of frank)" = 0 ] || fail "frank still holds research after the erasure"
echo "   frank refused every admin route; erin lists the accounts, gives frank a role at once, and cannot demote herself; the import's job listed still, after the restarts; frank's research erased, his export empty and erin's not"

echo "== install: signing in through the proxy, FRUS_AUTH=header behind docs/INSTALL.md's recipe"
# nginx runs the recipe with a stand-in for oauth2-proxy on 127.0.0.1:4180 in its own container:
# /oauth2/auth answers 202 naming the user its session cookie holds, or 401; the sign-in page takes
# a name, and /oauth2/start keeps it as the session and returns to the page first asked for. The
# server is made again trusting nginx's address alone, so curl, which reaches it from the Compose
# network's gateway through the published port, is outside the list.
cat > "$work/session.conf" <<'EOF'
server {
    listen 127.0.0.1:4180;
    absolute_redirect off;
    location = /oauth2/auth {
        if ($cookie_smoke_session = "") { return 401; }
        add_header X-Auth-Request-User $cookie_smoke_session always;
        return 202;
    }
    location = /oauth2/sign_in {
        default_type text/html;
        add_header Set-Cookie "smoke_return=$http_x_auth_request_redirect; Path=/; HttpOnly; SameSite=Lax" always;
        return 200 '<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Sign in</title></head><body><main><h1>Sign in</h1><form action="/oauth2/start"><label for="user">User name</label> <input id="user" name="user"> <button>Sign in</button></form></main></body></html>';
    }
    location = /oauth2/start {
        add_header Set-Cookie "smoke_session=$arg_user; Path=/; HttpOnly; SameSite=Lax" always;
        return 302 $cookie_smoke_return;
    }
}
EOF
start_proxy "signing in" /frus-explorer/reader/host.js "$work/session.conf"
proxy_address=$(docker inspect --format "{{(index .NetworkSettings.Networks \"${COMPOSE_PROJECT_NAME}_default\").IPAddress}}" "$proxy")
[ -n "$proxy_address" ] || fail "nginx has no address on the Compose network"
FRUS_PUBLIC_URL=http://localhost:8080/frus-explorer/ FRUS_AUTH=header FRUS_TRUSTED_PROXIES="$proxy_address" FRUS_ADMIN_USERS=alice \
  docker compose up -d frus 2>/dev/null
container=$(docker compose ps -q frus)
wait_for_200 "$base/readyz" 60 || fail "/readyz did not reach 200 behind sign-in"
# The server may have another address now, which nginx looks up again as it reloads.
docker exec "$proxy" nginx -s reload >/dev/null 2>&1 || fail "nginx did not reload"
for _ in $(seq 1 40); do
  [ "$(through_proxy /frus-explorer/reader/host.js)" = 200 ] && break
  sleep 0.25
done
[ "$(through_proxy /frus-explorer/reader/host.js)" = 200 ] || fail "the reader's script did not answer through nginx behind sign-in"

# From this machine, outside the list: refused, whatever it names, but for the health endpoints.
outside=$(curl -s --max-time 5 -H "Host: localhost:8080" -H 'X-Forwarded-User: alice' -w ' %{http_code}' "$under/api/v1/me" || true)
case "$outside" in *'"code":"PROXY_NOT_TRUSTED"'*' 403') ;; *) fail "a header from outside the list answered $outside" ;; esac
for path in /frus-explorer/ /frus-explorer/api/v1/status /frus-explorer/reader/host.js; do
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' -H 'X-Forwarded-User: alice' "$base$path" || true)
  [ "$code" = 403 ] || fail "$path answered $code from outside the list"
done
for path in /healthz /frus-explorer/readyz; do
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base$path" || true)
  [ "$code" = 200 ] || fail "$path answered $code from outside the list"
done
echo "   from outside the list, /api/v1/me naming alice, the app, the API and the reader's script refused; the health endpoints answered"

# Through nginx, from inside its container: a session first, then the user it names, whatever the
# browser's own header says.
in_proxy() { docker exec "$proxy" wget -q -O - "$@" 2>/dev/null; }
as() {  # $1: the session's user; the rest: wget's arguments
  local user=$1
  shift
  in_proxy --header "Cookie: smoke_session=$user" "$@"
}
me_path=http://localhost:8080/frus-explorer/api/v1/me
asked=$(in_proxy "$me_path" || true)
case "$asked" in *'<h1>Sign in</h1>'*) ;; *) fail "a request with no session was not asked to sign in: $asked" ;; esac
alice=$(as alice --header 'X-Forwarded-User: bob' "$me_path") || fail "alice's /api/v1/me did not answer through nginx"
case "$alice" in *'"userId":"alice"'*) ;; *) fail "alice's session, with a header naming bob, answered $alice" ;; esac
case "$alice" in *'"auth":"header"'*) ;; *) fail "the server does not sign in through the proxy: $alice" ;; esac
case "$alice" in *'"admin"'*) ;; *) fail "alice, whom FRUS_ADMIN_USERS names, is no admin: $alice" ;; esac
bob=$(as bob "$me_path") || fail "bob's /api/v1/me did not answer through nginx"
case "$bob" in *'"userId":"bob"'*) ;; *) fail "bob's session answered $bob" ;; esac
case "$bob" in *'"admin"'*) fail "bob is an admin: $bob" ;; esac
token=$(printf '%s' "$alice" | sed -nE 's/.*"csrfToken":"([0-9a-f]+)".*/\1/p')
made=$(as alice --header 'Content-Type: application/json' --header "X-CSRF-Token: $token" --header 'Origin: http://localhost:8080' \
  --post-data '{"name":"Smoke"}' "http://localhost:8080/frus-explorer/api/v1/me/tags") || fail "alice's tag was not made"
case "$made" in *'"name":"Smoke"'*) ;; *) fail "making alice's tag answered $made" ;; esac
tags=$(as alice http://localhost:8080/frus-explorer/api/v1/me/tags) || fail "alice's tags did not answer through nginx"
case "$tags" in *'"total":1'[,}]*) ;; *) fail "alice's tags are not the one she made: $tags" ;; esac
tags=$(as bob http://localhost:8080/frus-explorer/api/v1/me/tags) || fail "bob's tags did not answer through nginx"
case "$tags" in *'"total":0'[,}]*) ;; *) fail "bob's tags hold alice's: $tags" ;; esac
# What the reader's sandboxed frame asks for carries no cookie, and the recipe forwards it with no
# session: a figure the TEI lacks is the server's own 404, where the sign-in page would be a 200.
code=$(through_proxy /frus-explorer/api/v1/volumes/frus1961-63v06/figures/none.png || true)
[ "$code" = 404 ] || fail "a figure through nginx with no session answered $code, not the server's 404"
[ "$(through_proxy /frus-explorer/reader/frus-selection.js)" = 200 ] || fail "the reader's selection script needs a session through nginx"
echo "   through nginx: no session asks for a sign-in; alice's session is alice, an admin, whatever header the browser sends; bob's is bob; her tag is not his; the frame's scripts and figures need no session"

if [ -n "$e2e" ]; then
  echo "== install: signing in through the proxy, the sign-in spec in Playwright on Chromium"
  # The sign-in spec alone, in nginx's network namespace, under the path.
  FRUS_E2E_SIGN_IN=1 FRUS_E2E_NETWORK="container:$proxy" FRUS_E2E_BASE_URL=http://localhost:8080/frus-explorer/ scripts/npm --playwright \
    || fail "the sign-in spec failed; web/playwright-report has its report"
fi

echo "== install: health check behind sign-in"
wait_healthy
echo "   healthy"

passed=1
echo "PASS: compose smoke test"
