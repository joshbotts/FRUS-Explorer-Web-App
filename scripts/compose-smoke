assert cited["provenanceNote"].startswith("This volume was side-loaded, not downloaded from the published catalogue. This server cannot confirm it is published"), cited
assert "canonicalURL" not in cited and "history.state.gov" not in cited["bibtex"], cited' "$work/draft-citation.json" \
  || fail "the side-loaded volume's citation does not carry the app's sentence: $(head -c 400 "$work/draft-citation.json")"
probe=$(curl -s --max-time 10 "$library_base/api/v1/search?keywords=smokeprobe" | sed -nE 's/.*"total":([0-9]+).*/\1/p')
