# The build needs the package, its sources and tests (SwiftPM checks every target's path),
# the submodule's source folders, and LICENSE. Everything else stays out, so edits to docs,
# scripts or CI do not invalidate the build layer.
.build
.swiftpm
**/.git
**/.DS_Store
node_modules
.env
tei
docs
fixtures
scripts
.github
README.md
CLAUDE.md
compose.yaml
upstream/FRUS-Explorer/Planning
upstream/FRUS-Explorer/Docs
upstream/FRUS-Explorer/Vendor
